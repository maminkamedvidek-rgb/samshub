SAFE("Teleport",function()
	local P=UI.Teleport
	local rows,busy={},false
	SEC(P,"Selected player")
	local selL=LB(P,"Selected: none",U2(1,-8,0,18),nil,"muted",FM,12)
	selL.LayoutOrder=NO()
	local function need()
		if S.selected then return S.selected end
		toast("Select a player first (the list is at the bottom)","warn")
	end
	BTN(P,"Teleport To Selected",function()
		local s=need()
		if not s or busy then return end
		busy=true
		local ok,err=F.tp(s)
		busy=false
		if ok then toast("Teleported to "..s.DisplayName) else toast(err or "Teleport failed","err") end
	end)
	BTN(P,"Tick TP",function()
		local s=need()
		if not s then return end
		if F.tick({s},0.15)>0 then toast("Tick TP: "..s.DisplayName) else toast("Tick TP failed","err") end
	end,"accent2")
	BTN(P,"Tick Everyone",function()
		local l={}
		for _,p in ipairs(Pl:GetPlayers()) do
			if p~=LP then l[#l+1]=p end
		end
		toast("Ticked "..F.tick(l,0.1).." players")
	end,"accent2")
	local spec=false
	local specApi=TOG(P,"Spectate Selected","Watch the selected player",function(on)
		if on then
			local s=need()
			if not s or not F.spectate(s) then
				toast("Select a loaded player first","warn")
				return false
			end
			spec=true
		else
			F.spectate(nil)
			spec=false
		end
	end)
	TOG(P,"Follow Selected","Your character walks to the selected player",function(on)
		if on and not S.selected then
			toast("Select a player first (the list is at the bottom)","warn")
			return false
		end
		F.follow(on)
	end)
	TOG(P,"Orbit Selected","Circle around the selected player",function(on)
		if on and not S.selected then
			toast("Select a player first (the list is at the bottom)","warn")
			return false
		end
		F.orbit(on)
	end)
	SLD(P,"Orbit radius",3,40,8,function(v) S.orbitR=v end,function() S.orbitR=8 end)
	BTN(P,"TP to random player",function()
		local p,err=F.randomTP()
		if p then toast("Teleported to "..p.DisplayName) else toast(err or "No one to teleport to","warn") end
	end,"accent2")
	hooks[#hooks+1]=function()
		if spec then
			spec=false
			specApi.Set(false,true)
		end
	end
	SEC(P,"Saved locations")
	local slotLbl={}
	local function slotText(i)
		local c=S.saved[i]
		return c and ("%d. %d, %d, %d"):format(i,math.floor(c.X),math.floor(c.Y),math.floor(c.Z)) or (i..". Empty")
	end
	for i=1,3 do
		local row=N("Frame",{Size=U2(1,-8,0,40),BackgroundTransparency=0.2,LayoutOrder=NO()},P)
		B(row,"BackgroundColor3","panel")
		CO(row,10)
		slotLbl[i]=LB(row,slotText(i),U2(1,-150,1,0),UO(10,0),"white",FM,12)
		local function mk(txt,x,w,ck,fn)
			local b=N("TextButton",{Size=UO(w,26),Position=U2(1,x,0.5,-13),Text=txt,TextColor3=WHITE,Font=FB,TextSize=12,AutoButtonColor=false},row)
			B(b,"BackgroundColor3",ck)
			CO(b,8)
			b.MouseButton1Click:Connect(fn)
		end
		mk("Save",-138,40,"accent2",function()
			if F.saveLoc(i) then
				slotLbl[i].Text=slotText(i)
				queueSave()
				if S.mkOn then F.markers(true) end
				toast("Saved to slot "..i)
			else
				toast("Your character isn't loaded","err")
			end
		end)
		mk("TP",-94,40,"accent",function()
			local ok,err=F.tpSaved(i)
			if ok then toast("Teleported to slot "..i) else toast(err,"warn") end
		end)
		mk("Del",-50,42,"off",function()
			S.saved[i]=nil
			slotLbl[i].Text=slotText(i)
			queueSave()
			if S.mkOn then F.markers(true) end
			toast("Slot "..i.." cleared")
		end)
		UI.addSearch(row,P,"saved location slot "..i,"Saved location "..i)
		reg("loc"..i,1,function()
			local c=S.saved[i]
			if c then return {pid=game.PlaceId,c={c:GetComponents()}} end
		end,function(v)
			if type(v)=="table" and v.pid==game.PlaceId and type(v.c)=="table" and #v.c==12 then
				S.saved[i]=CFrame.new(table.unpack(v.c))
				slotLbl[i].Text=slotText(i)
			end
		end)
	end
	TOG(P,"Show markers","Floating labels at your saved spots (only you see them)",function(on) F.markers(on) end,"mkr")
	BTN(P,"Go back to previous position",function()
		local ok,err=F.back()
		if ok then toast("Went back") else toast(err,"warn") end
	end,"accent2")
	BTN(P,"Teleport to spawn",function()
		local ok,err=F.tpSpawn()
		if ok then toast("Teleported to spawn") else toast(err,"warn") end
	end,"accent2")
	local hdr=SEC(P,"Players")
	F.colorRows=function()
		for p,r in pairs(rows) do
			local sel=p==S.selected
			r.BackgroundColor3=sel and T.accent or T.off
			r.Check.Visible=sel
		end
		local s=S.selected
		local txt=s and ("Selected: "..s.DisplayName.." (@"..s.Name..")") or "Selected: none"
		selL.Text=txt
		selL.TextColor3=s and WHITE or T.muted
		if UI.opSel then UI.opSel.Text=txt.."  (pick in Teleport)" end
	end
	F.refreshList=function()
		for _,r in pairs(rows) do r:Destroy() end
		table.clear(rows)
		if S.selected and S.selected.Parent~=Pl then S.selected=nil end
		local count=0
		for _,p in ipairs(Pl:GetPlayers()) do
			if p~=LP then
				count=count+1
				local row=N("TextButton",{Size=U2(1,-8,0,40),BackgroundColor3=T.off,Text="",AutoButtonColor=false,LayoutOrder=1000+count},P)
				CO(row,10)
				CO(N("ImageLabel",{Size=UO(30,30),Position=UO(6,5),BackgroundColor3=T.panel,Image="rbxthumb://type=AvatarHeadShot&id="..p.UserId.."&w=48&h=48"},row))
				LB(row,p.DisplayName,U2(1,-96,0,18),UO(44,4),"white",FB,13)
				LB(row,"@"..p.Name,U2(1,-96,0,14),UO(44,22),T.muted,FR,11)
				LB(row,"OK",UO(30,40),U2(1,-36,0,0),"white",FB,12).Name="Check"
				row.Check.Visible=false
				row.MouseButton1Click:Connect(function()
					S.selected=p
					F.colorRows()
				end)
				rows[p]=row
			end
		end
		hdr.Text="Players ("..count..")"
		F.colorRows()
	end
	TK(Pl.PlayerAdded:Connect(function() task.defer(F.refreshList) end))
	TK(Pl.PlayerRemoving:Connect(function(p)
		F.clearESP(p)
		if S.selected==p then S.selected=nil end
		task.defer(F.refreshList)
	end))
	F.refreshList()
end)
SAFE("Tools",function()
	local P=UI.Tools
	local rows,found,shownList={},{},{}
	local cnt=SEC(P,"Tools")
	local sb=N("TextBox",{Size=U2(1,-8,0,34),Text="",PlaceholderText="Search tools...",PlaceholderColor3=T.muted,TextColor3=WHITE,Font=FM,TextSize=13,ClearTextOnFocus=false,BackgroundTransparency=0.2,LayoutOrder=NO()},P)
	B(sb,"BackgroundColor3","panel")
	CO(sb,10)
	local function build()
		for _,r in ipairs(rows) do r:Destroy() end
		table.clear(rows)
		table.clear(shownList)
		local q,shown=sb.Text:lower(),0
		for _,t in ipairs(found) do
			if q=="" or t.Name:lower():find(q,1,true) then
				shown=shown+1
				if shown<=120 then
					shownList[#shownList+1]=t
					local row=N("Frame",{Size=U2(1,-8,0,44),BackgroundColor3=T.off,LayoutOrder=1000+shown},P)
					CO(row,10)
					LB(row,t.Name,U2(1,-150,0,20),UO(10,4),"white",FB,13)
					LB(row,"in "..(t.Parent and t.Parent.Name or "?"),U2(1,-150,0,14),UO(10,24),T.muted,FR,11)
					local gb=N("TextButton",{Size=UO(60,28),Position=U2(1,-68,0.5,-14),BackgroundColor3=T.accent,Text="Give",TextColor3=WHITE,Font=FB,TextSize=13},row)
					CO(gb,8)
					local hd=t:FindFirstChild("Handle")
					if hd and t:IsDescendantOf(workspace) then
						local tb=N("TextButton",{Size=UO(60,28),Position=U2(1,-134,0.5,-14),BackgroundColor3=T.accent2,Text="TP",TextColor3=WHITE,Font=FB,TextSize=13},row)
						CO(tb,8)
						tb.MouseButton1Click:Connect(function()
							local r=gR()
							if r then
								mark()
								pivot(hd.CFrame+V3(0,3,0))
								r.AssemblyLinearVelocity=ZERO
							end
						end)
					end
					gb.MouseButton1Click:Connect(function()
						if F.giveTool(t) then toast(t.Name.." added to your backpack") else toast("Couldn't give "..t.Name,"err") end
					end)
					rows[#rows+1]=row
				end
			end
		end
		cnt.Text="Tools found ("..#found..")"..(shown>120 and "  showing 120" or "")
	end
	local scanning,first=false,true
	local function scan()
		if scanning then return end
		scanning=true
		cnt.Text="Scanning..."
		task.spawn(function()
			found=F.scanTools()
			scanning=false
			build()
			toast("Found "..#found.." tools")
		end)
	end
	BTN(P,"Rescan tools",scan,"accent2")
	BTN(P,"Give all shown",function()
		local n=0
		for _,t in ipairs(shownList) do
			if F.giveTool(t) then n=n+1 end
		end
		toast("Added "..n.." tools to your backpack")
	end,"accent2")
	sb:GetPropertyChangedSignal("Text"):Connect(build)
	F.toolsOpen=function()
		if first then
			first=false
			scan()
		end
	end
end)
SAFE("Misc",function()
	local P=UI.Misc
	SEC(P,"Protection")
	TOGK(P,"Anti Fling","Others can't fling you",function(on) F.antiFling(on) end,"af",Enum.KeyCode.P)
	TOG(P,"Anti AFK","Stops the idle kick",function(on) S.antiAfk=on end,"afk")
	SEC(P,"Emotes")
	local function emoteBtn(n)
		BTN(P,n,function()
			local r=F.emote(n)
			if r=="stopped" then toast(n.." stopped") elseif r then toast(n..(S.cm and " (move to stop)" or "")) else toast("Couldn't play "..n.." on this character","err") end
		end,"off")
	end
	emoteBtn("Backflip")
	emoteBtn("Take the L")
	emoteBtn("Spin")
	for _,e in ipairs(F.emotes) do emoteBtn(e[1]) end
	BTN(P,"Stop Emote",function()
		F.stopEmote()
		toast("Emote stopped")
	end)
	SEC(P,"Camera and world")
	local fb=workspace.CurrentCamera and workspace.CurrentCamera.FieldOfView or 70
	SLD(P,"Field of View",30,120,math.floor(fb+0.5),function(v) S.fovWant=v end,function()
		S.fovWant=nil
		local c=workspace.CurrentCamera
		if c then c.FieldOfView=fb end
	end,"fov")
	TOG(P,"Unlock Zoom","Zoom the camera out much further",function(on) F.zoom(on) end,"zm")
	SLD(P,"Time of day",0,24,14,function(v) F.tod(v) end,function() F.tod(nil) end)
	TOG(P,"Fullbright","Removes darkness and fog",function(on) F.fullbright(on) end,"fb")
	TOG(P,"Clear Fog","Removes distance fog and haze",function(on) F.clearFog(on) end,"cf")
	TOG(P,"Crosshair","A dot in the middle of your screen",function(on) UI.cross.Visible=on end,"cross")
	TOG(P,"Low Graphics","Less lag on weak phones",function(on) F.lowGfx(on) end,"lg")
	TOG(P,"First Person Lock","Locks the camera in first person",function(on) F.fpLock(on) end,"fp")
	SEC(P,"Menu")
	SLD(P,"Window transparency",0,80,6,function(v) UI.setWinT(v/100) end,function() UI.setWinT(0.06) end,"wt")
	SLD(P,"Menu size",60,130,100,function(v) UI.setScale(v/100) end,function() UI.setScale(1) end,"ui")
	TOG(P,"Quiet notifications","Only show errors",function(on) S.quiet=on end,"qt")
	TOG(P,"Join / leave alerts","A notification when players come and go",function(on) F.joinAlerts(on) end,"jl")
	TOG(P,"Hide S button","PC only: use Right Ctrl to open the menu",function(on)
		if on and not S.hasKb then
			toast("Needs a keyboard, or you couldn't reopen the menu","warn")
			return false
		end
		UI.setS(not on)
	end,"hs")
	SEC(P,"Sound and performance")
	TOG(P,"Mute game","Silences the whole game",function(on) F.mute(on) end,"mu")
	TOG(P,"Unlock FPS","Raises the frame cap (needs executor support)",function(on)
		if not setfpscap then
			toast("Your executor can't change the FPS cap","warn")
			return false
		end
		setfpscap(on and 999 or 60)
	end,"fc")
	SEC(P,"Skins")
	DDN(P,"Skin",{"Default","Marin","Muichiro","Old","Neon"},function() return S.curTheme end,function(n)
		F.applyTheme(n)
		queueSave()
		toast(n.." skin applied")
	end)
	local bar=N("Frame",{Size=U2(1,-8,0,14),BackgroundColor3=WHITE,LayoutOrder=NO()},P)
	CO(bar,7)
	local bg=N("UIGradient",{},bar)
	local function upd()
		TH.Neon=neonTheme()
		bg.Color=ColorSequence.new(Color3.fromHSV(S.nh1/360,1,1),Color3.fromHSV(S.nh2/360,1,1))
		if S.curTheme=="Neon" then F.applyTheme("Neon") end
	end
	upd()
	SLD(P,"Neon color 1",0,360,S.nh1,function(v)
		S.nh1=v
		upd()
	end,nil,"nh1")
	SLD(P,"Neon color 2",0,360,S.nh2,function(v)
		S.nh2=v
		upd()
	end,nil,"nh2")
	SEC(P,"Settings")
	local sv=TOG(P,"Save settings","Remember your setup between joins",function(on)
		S.saveOn=on
		if on then
			saveNow()
			toast("Settings will save and load automatically")
		else
			pcall(function() writefile(CFG,'{"saveOn":false}') end)
			toast("Saving turned off")
		end
	end)
	sv.Set(S.saveOn,true)
	BTN(P,"Reset saved settings",function()
		S.saveOn=false
		sv.Set(false,true)
		pcall(function()
			if delfile then delfile(CFG) else writefile(CFG,'{"saveOn":false}') end
		end)
		toast("Saved settings deleted. Rejoin to get the defaults.")
	end,"off")
	reg("theme",2,function() return S.curTheme end,function(v) if TH[v] then F.applyTheme(v) end end)
end)
SAFE("Fun",function()
	local P=UI.Fun
	SEC(P,"Looks (only you see these)")
	TOG(P,"Rainbow Character","Your body cycles through colors",function(on) F.rainbow(on) end,"rb")
	TOG(P,"Trail","A glowing trail behind you",function(on)
		if not F.trail(on) then
			toast("Character not loaded","err")
			return false
		end
	end,"tr")
	TOG(P,"Sparkles","Particles around you",function(on)
		if not F.sparkle(on) then
			toast("Character not loaded","err")
			return false
		end
	end,"sk")
	TOG(P,"Disco Lights","Flashing colored lighting",function(on) F.disco(on) end)
	SEC(P,"Character")
	TOG(P,"Freeze Character","Lock yourself in place",function(on)
		if not F.freeze(on) then
			toast("Character not loaded","err")
			return false
		end
	end)
	BTN(P,"Sit down",function()
		local h=gH()
		if h then h.Sit=true end
	end,"off")
	SEC(P,"World")
	TOG(P,"Click Hide","Tap or click a part to hide it for yourself",function(on) S.clickDel=on end)
	BTN(P,"Undo last hide",function()
		if F.undoDel() then toast("Brought it back") else toast("Nothing to undo","warn") end
	end,"off")
end)
SAFE("Server",function()
	local P=UI.Server
	SEC(P,"This server")
	local info=LB(P,"",U2(1,-8,0,52),nil,"muted",FM,12)
	info.LayoutOrder=NO()
	info.TextWrapped=true
	info.TextYAlignment=Enum.TextYAlignment.Top
	local gname="Loading game name..."
	task.spawn(function()
		local ok,i=pcall(function() return game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId) end)
		if ok and i then gname=i.Name end
	end)
	task.spawn(function()
		while info.Parent do
			local t=math.floor(workspace.DistributedGameTime)
			info.Text=gname.."\nPlace "..game.PlaceId.."  •  "..#Pl:GetPlayers().."/"..Pl.MaxPlayers.." players  •  "..math.floor(t/60).."m up\nJob "..string.sub(game.JobId,1,22)
			task.wait(1)
		end
	end)
	local function copy(text,what)
		local sc=setclipboard or toclipboard
		if sc then
			sc(text)
			toast(what.." copied")
		else
			toast("Your executor can't copy to the clipboard","warn")
		end
	end
	SEC(P,"Move")
	BTN(P,"Rejoin Server",function()
		toast("Rejoining...")
		pcall(function() game:GetService("TeleportService"):Teleport(game.PlaceId,LP) end)
	end,"off")
	BTN(P,"Server Hop (random)",function()
		toast("Looking for another server...")
		task.spawn(function()
			if not F.hop(false) then toast("Couldn't find another server (or HttpGet is blocked)","warn") end
		end)
	end,"off")
	BTN(P,"Hop to a small server",function()
		toast("Looking for the emptiest server...")
		task.spawn(function()
			if not F.hop(true) then toast("Couldn't find another server (or HttpGet is blocked)","warn") end
		end)
	end,"off")
	TOG(P,"Auto Rejoin on kick","Rejoins the game if you get disconnected",function(on)
		if not F.autoRejoin(on) then
			toast("Couldn't hook the disconnect screen on this executor","warn")
			return false
		end
	end,"arj")
	SEC(P,"Copy")
	BTN(P,"Copy server JobId",function() copy(game.JobId,"JobId") end,"off")
	BTN(P,"Copy PlaceId",function() copy(tostring(game.PlaceId),"PlaceId") end,"off")
	BTN(P,"Copy join link",function() copy(("roblox://experiences/start?placeId=%d&gameInstanceId=%s"):format(game.PlaceId,game.JobId),"Join link") end,"off")
	BTN(P,"Copy my position",function()
		local r=gR()
		if r then copy(("%d, %d, %d"):format(math.floor(r.Position.X),math.floor(r.Position.Y),math.floor(r.Position.Z)),"Position") else toast("Your character isn't loaded","err") end
	end,"off")
	SEC(P,"Remotes the game exposes (read-only)")
	local rcnt=LB(P,"Not scanned yet",U2(1,-8,0,18),nil,"muted",FM,12)
	rcnt.LayoutOrder=NO()
	local rrows,scanning={},false
	BTN(P,"Scan remotes",function()
		if scanning then return end
		scanning=true
		rcnt.Text="Scanning..."
		task.spawn(function()
			local list=F.scanRemotes()
			for _,r in ipairs(rrows) do r:Destroy() end
			table.clear(rrows)
			for i,d in ipairs(list) do
				if i>100 then break end
				local row=N("Frame",{Size=U2(1,-8,0,44),BackgroundColor3=T.off,LayoutOrder=1000+i},P)
				CO(row,10)
				LB(row,d.Name,U2(1,-76,0,20),UO(10,4),"white",FB,13)
				LB(row,(d:IsA("RemoteEvent") and "Event" or "Function").."  "..d:GetFullName(),U2(1,-76,0,14),UO(10,24),T.muted,FR,10)
				local cb=N("TextButton",{Size=UO(54,28),Position=U2(1,-60,0.5,-14),BackgroundColor3=T.accent,Text="Copy",TextColor3=WHITE,Font=FB,TextSize=12},row)
				CO(cb,8)
				cb.MouseButton1Click:Connect(function() copy(d:GetFullName(),"Path") end)
				rrows[#rrows+1]=row
			end
			rcnt.Text="Remotes found: "..#list..(#list>100 and " (showing 100)" or "")
			scanning=false
		end)
	end,"accent2")
end)
SAFE("Overpowered",function()
	local P=UI.Overpowered
	SEC(P,"Self")
	TOG(P,"Invisibility","Body goes under the map, hitbox stays",function(on)
		local m=F.invis(on)
		if not m then
			toast("Character not loaded","err")
			return false
		end
		if not on then
			toast("Visible again")
		elseif m=="split" then
			toast("Invisible: body moved under the map")
		else
			toast("Only hidden on your screen (this rig can't be split)","warn")
		end
	end,"inv")
	TOG(P,"Invincibility","Infinite HP and dodges damage",function(on) F.god(on) end,"god")
	TOG(P,"Anti Anti-Cheat","Blocks forced teleports and rubber-banding",function(on) F.aac(on) end,"aac")
	SEC(P,"Fling of God")
	UI.opSel=LB(P,"Selected: none  (pick in Teleport)",U2(1,-8,0,18),nil,"muted",FM,12)
	UI.opSel.LayoutOrder=NO()
	if F.colorRows then F.colorRows() end
	BTN(P,"Fling of God",function(btn)
		local who=S.selected
		if not who then
			toast("Select a player in Teleport first","warn")
			return
		end
		toast("Flinging "..who.DisplayName.."...")
		local ok,err=F.godFling(who,function(s) btn.Text="Flinging... "..s.."s" end)
		btn.Text="Fling of God"
		if ok then toast(who.DisplayName.." got flung, you're back home") else toast(err or "Failed","err") end
	end)
	SEC(P,"Aimbot")
	TOGK(P,"Aimbot","Locks onto the closest player in front of you",function(on)
		S.aimOn=on
		UI.circle.Visible=on
	end,"aim",Enum.KeyCode.V)
	SLD(P,"Aim strength",1,100,S.aimStr,function(v) S.aimStr=v end,nil,"aimStr")
	SLD(P,"Aim radius",50,600,S.aimRad,function(v)
		S.aimRad=v
		UI.circle.Size=UO(v*2,v*2)
	end,nil,"aimRad")
	TOG(P,"Wall check","Ignore players behind walls",function(on) S.aimWall=on end,"aimWall",true).Set(true,true)
	TOG(P,"Team check","Ignore your teammates",function(on) S.aimTeam=on end,"aimTeam")
	DDN(P,"Aim target",{"Head","HumanoidRootPart"},function() return S.aimPart or "Head" end,function(n) S.aimPart=n end)
	SEC(P,"Combat")
	TOG(P,"Hitbox Expander","Makes other players' hitboxes bigger",function(on) F.hitbox(on) end,"hb")
	SLD(P,"Hitbox size",2,30,8,function(v) S.hbSize=v end,function() S.hbSize=8 end,"hbs")
	TOG(P,"Auto Clicker","Keeps using the tool you're holding",function(on) F.autoClick(on) end,"ac")
	SLD(P,"Clicks per second",1,30,10,function(v) S.acInt=1/v end,function() S.acInt=0.1 end,"acs")
end)
SAFE("All",function() UI.buildAll() end)
TK(LP.CharacterAdded:Connect(function()
	for _,f in ipairs(hooks) do pcall(f) end
end))
UI.showTab("Main")
if S.saveOn then
	local list={}
	for k,r in pairs(regs) do
		if cfg[k]~=nil then list[#list+1]={k,r} end
	end
	table.sort(list,function(a,b) return a[2].o<b[2].o end)
	for _,e in ipairs(list) do pcall(e[2].set,cfg[e[1]]) end
	toast("Sams Hub V6.5 loaded with your saved settings")
else
	toast("Sams Hub V6.5 loaded - tap the S button")
end
_G.SamsHubCleanup=function()
	for _,f in ipairs(cleanups) do pcall(f) end
	for _,c in ipairs(conns) do pcall(function() c:Disconnect() end) end
end