	N("UIListLayout",{Padding=UDim.new(0,2),SortOrder=Enum.SortOrder.LayoutOrder},tabBar)
	local prof=N("Frame",{AnchorPoint=Vector2.new(0,1),Position=U2(0,0,1,0),Size=UO(SW,40),BackgroundTransparency=0.25},side)
	B(prof,"BackgroundColor3","panel")
	CO(prof,10)
	CO(N("ImageLabel",{Size=UO(28,28),Position=UO(6,6),BackgroundColor3=WHITE,BackgroundTransparency=0.7,Image="rbxthumb://type=AvatarHeadShot&id="..LP.UserId.."&w=48&h=48"},prof))
	LB(prof,LP.DisplayName,UO(SW-42,16),UO(38,4),"white",FB,11)
	LB(prof,"@"..LP.Name,UO(SW-42,14),UO(38,20),"muted",FR,10)
	local content=N("Frame",{Position=UO(SW+20,4),Size=U2(1,-(SW+30),1,-14),BackgroundTransparency=0.6},body)
	B(content,"BackgroundColor3","panel")
	CO(content,12)
	local pageHolder=N("CanvasGroup",{Position=UO(6,6),Size=U2(1,-12,1,-12),BackgroundTransparency=1},content)
	local tabs,pages,names,order,srch={},{},{},0,{}
	UI.srch=srch
	function NO()
		order=order+1
		return order
	end
	local function showTab(name)
		local changed=S.curTab~=name
		S.curTab=name
		for n,p in pairs(pages) do p.Visible=(n==name) end
		for n,b in pairs(tabs) do
			local on=n==name
			tw(b,0.18,{BackgroundTransparency=on and 0.1 or 1})
			tw(names[n],0.18,{TextColor3=on and WHITE or T.muted})
		end
		if changed then
			pageHolder.GroupTransparency=1
			pages[name].Position=UO(0,10)
			tw(pageHolder,0.2,{GroupTransparency=0})
			tw(pages[name],0.24,{Position=UO(0,0)},ES.Quint)
		end
		if name=="Teleport" and F.refreshList then F.refreshList() end
		if name=="Tools" and F.toolsOpen then F.toolsOpen() end
	end
	UI.showTab=showTab
	local ICON={All="📋",Main="🏠",ESP="👁",Teleport="📍",Tools="🧰",Fun="🎉",Server="🌐",Camera="🎥",Radar="📡",Console="💻",Routes="🛣",Quick="⚡",Misc="⚙",Overpowered="⭐"}
	for _,nm in ipairs({"All","Main","ESP","Teleport","Tools","Fun","Server","Camera","Radar","Console","Routes","Quick","Misc","Overpowered"}) do
		local b=N("TextButton",{Size=U2(1,0,0,28),BackgroundTransparency=1,Text="",LayoutOrder=NO(),AutoButtonColor=false},tabBar)
		B(b,"BackgroundColor3","panel")
		CO(b,9)
		N("TextLabel",{Size=UO(22,28),Position=UO(6,0),BackgroundTransparency=1,Text=ICON[nm],TextSize=13,TextColor3=WHITE,Font=FM},b)
		names[nm]=LB(b,nm,U2(1,-34,1,0),UO(30,0),"muted",FB,12)
		b.MouseButton1Click:Connect(function() showTab(nm) end)
		tabs[nm]=b
		local pg=N("ScrollingFrame",{Size=US(1,1),BackgroundTransparency=1,BorderSizePixel=0,ScrollBarThickness=3,CanvasSize=UO(0,0),AutomaticCanvasSize=Enum.AutomaticSize.Y,Visible=false},pageHolder)
		B(pg,"ScrollBarImageColor3","accent")
		N("UIListLayout",{Padding=UDim.new(0,6),SortOrder=Enum.SortOrder.LayoutOrder},pg)
		pages[nm]=pg
		UI[nm]=pg
	end
	local function applySearch()
		local q=search.Text:lower()
		local first,curHas
		for _,e in ipairs(srch) do
			local show=q=="" or (e[3]~=nil and e[3]:find(q,1,true)~=nil)
			e[1].Visible=show
			if show and q~="" then
				if e[2]==pages[S.curTab] then curHas=true end
				first=first or e[2]
			end
		end
		if q~="" and not curHas and first then
			for n,p in pairs(pages) do
				if p==first then showTab(n) end
			end
		end
	end
	search:GetPropertyChangedSignal("Text"):Connect(applySearch)
	local function PNL(class,par,h,key)
		local o=N(class,{Size=U2(1,-8,0,h),BackgroundTransparency=0.2,LayoutOrder=NO()},par)
		B(o,"BackgroundColor3","panel")
		CO(o,10)
		if class=="TextButton" then
			o.Text=""
			o.AutoButtonColor=false
			o.MouseButton1Down:Connect(function() tw(o,0.08,{BackgroundTransparency=0}) end)
			local function rel() tw(o,0.18,{BackgroundTransparency=0.2}) end
			o.MouseButton1Up:Connect(rel)
			o.MouseLeave:Connect(rel)
		end
		if key then srch[#srch+1]={o,par,key:lower()} end
		return o
	end
	function SEC(par,text)
		local f=N("Frame",{Size=U2(1,-8,0,24),BackgroundTransparency=1,LayoutOrder=NO()},par)
		srch[#srch+1]={f,par,nil}
		return LB(f,text,U2(1,-8,1,0),UO(4,0),"white",FB,14)
	end
	function TOG(par,text,desc,cb,key,full)
		local state,api=false,{watch={}}
		local row=PNL("TextButton",par,46,text.." "..(desc or ""))
		local ent=srch[#srch]
		ent.api,ent.name,ent.desc=api,text,desc
		function api.get() return state end
		LB(row,text,U2(1,-70-(S.hasKb and 56 or 0),0,20),UO(12,6),"white",FM,14)
		LB(row,desc or "",U2(1,-70-(S.hasKb and 56 or 0),0,14),UO(12,25),"muted",FR,11)
		local pill=N("Frame",{Size=UO(42,22),Position=U2(1,-54,0.5,-11)},row)
		B(pill,"BackgroundColor3",function() return state and T.accent or T.off end)
		CO(pill)
		local knob=N("Frame",{Size=UO(18,18),Position=UO(2,2),BackgroundColor3=WHITE},pill)
		CO(knob)
		function api.Set(v,silent)
			if not silent and cb and cb(v)==false then return end
			state=v
			for _,f in ipairs(api.watch) do f(v) end
			tw(pill,0.2,{BackgroundColor3=v and T.accent or T.off},ES.Quint)
			tw(knob,0.2,{Position=v and UO(22,2) or UO(2,2)},ES.Back)
			if not silent then queueSave() end
		end
		function api.Toggle() api.Set(not state) end
		row.MouseButton1Click:Connect(api.Toggle)
		if key then
			reg(key,3,function()
				if full then return state end
				return state or nil
			end,function(v) api.Set(v) end)
		end
		return api,row
	end
	function BTN(par,text,cb,ck)
		local b=N("TextButton",{Size=U2(1,-8,0,38),Text=text,TextColor3=WHITE,Font=FB,TextSize=14,LayoutOrder=NO(),AutoButtonColor=false},par)
		B(b,"BackgroundColor3",ck or "accent")
		CO(b,10)
		b.MouseButton1Down:Connect(function() tw(b,0.08,{BackgroundTransparency=0.3}) end)
		local function rel() tw(b,0.2,{BackgroundTransparency=0}) end
		b.MouseButton1Up:Connect(rel)
		b.MouseLeave:Connect(rel)
		b.MouseButton1Click:Connect(function() cb(b) end)
		srch[#srch+1]={b,par,text:lower(),name=text}
		return b
	end
	function DDN(par,label,opts,get,set)
		local f=N("Frame",{Size=U2(1,-8,0,44),BackgroundTransparency=0.2,ClipsDescendants=true,LayoutOrder=NO()},par)
		B(f,"BackgroundColor3","panel")
		CO(f,10)
		LB(f,label,U2(1,-130,0,44),UO(12,0),"white",FM,14)
		local cur=N("TextButton",{Size=UO(104,28),Position=U2(1,-114,0,8),Text="",AutoButtonColor=false},f)
		B(cur,"BackgroundColor3","off")
		CO(cur,8)
		local cl=LB(cur,"",UO(80,28),UO(8,0),"white",FB,12)
		LB(cur,"v",UO(20,28),U2(1,-22,0,0),"muted",FB,11,XA.Center)
		local open=false
		local function refresh() cl.Text=get() end
		refresh()
		for i,o in ipairs(opts) do
			local ob=N("TextButton",{Size=U2(1,-16,0,26),Position=UO(8,48+(i-1)*28),Text=o,TextColor3=WHITE,Font=FM,TextSize=12,AutoButtonColor=false,BackgroundTransparency=0.35},f)
			B(ob,"BackgroundColor3","off")
			CO(ob,8)
			ob.MouseButton1Click:Connect(function()
				set(o)
				refresh()
				open=false
				tw(f,0.2,{Size=U2(1,-8,0,44)},ES.Quint)
			end)
		end
		cur.MouseButton1Click:Connect(function()
			open=not open
			tw(f,0.22,{Size=U2(1,-8,0,open and 52+#opts*28 or 44)},ES.Quint)
		end)
		srch[#srch+1]={f,par,label:lower(),name=label}
		return refresh
	end
	function SLD(par,label,mn,mx,def,onChange,onReset,key)
		local row=PNL("Frame",par,52,label)
		srch[#srch].name=label
		LB(row,label,U2(0.5,0,0,20),UO(12,5),"white",FM,13)
		local val=LB(row,tostring(def),UO(50,20),U2(1,onReset and -90 or -62,0,5),"accent",FB,13,XA.Right)
		local bar=N("Frame",{Size=U2(1,-24,0,6),Position=UO(12,36),BorderSizePixel=0},row)
		B(bar,"BackgroundColor3","off")
		CO(bar)
		local fill=N("Frame",{Size=US(0,1),BorderSizePixel=0},bar)
		B(fill,"BackgroundColor3","accent")
		CO(fill)
		local knob=N("Frame",{Size=UO(14,14),AnchorPoint=Vector2.new(0.5,0.5),Position=US(0,0.5),BackgroundColor3=WHITE},bar)
		CO(knob)
		local hit=N("TextButton",{Size=U2(1,-12,0,24),Position=UO(6,27),BackgroundTransparency=1,Text=""},row)
		local cur,changed,dragging=def,false,false
		local function setv(v)
			v=math.clamp(v,mn,mx)
			local a=(v-mn)/(mx-mn)
			fill.Size=US(a,1)
			knob.Position=US(a,0.5)
			val.Text=tostring(math.floor(v+0.5))
		end
		setv(def)
		local function fromX(x)
			local v=math.floor(mn+(mx-mn)*math.clamp((x-bar.AbsolutePosition.X)/math.max(bar.AbsoluteSize.X,1),0,1)+0.5)
			setv(v)
			cur,changed=v,true
			onChange(v)
			queueSave()
		end
		hit.InputBegan:Connect(function(i)
			if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
				dragging=true
				par.ScrollingEnabled=false
				fromX(i.Position.X)
			end
		end)
		TK(UIS.InputChanged:Connect(function(i)
			if dragging and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then fromX(i.Position.X) end
		end))
		TK(UIS.InputEnded:Connect(function(i)
			if dragging and (i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch) then
				dragging=false
				par.ScrollingEnabled=true
			end
		end))
		if onReset then
			local r=N("TextButton",{AnchorPoint=Vector2.new(1,0),Size=UO(24,20),Position=U2(1,-8,0,5),Text="R",TextColor3=WHITE,Font=FB,TextSize=12},row)
			B(r,"BackgroundColor3","off")
			CO(r,6)
			r.MouseButton1Click:Connect(function()
				setv(def)
				cur,changed=def,false
				onReset()
				queueSave()
			end)
		end
		if key then
			reg(key,(key=="nh1" or key=="nh2") and 0 or 1,function()
				if changed then return cur end
			end,function(v)
				setv(v)
				cur,changed=v,true
				onChange(v)
			end)
		end
	end
	local hot,owners,listening={},{},nil
	function KEY(row,def,fn)
		if not S.hasKb then return end
		local cur
		local chip=N("TextButton",{Size=UO(50,22),Position=U2(1,-114,0.5,-11),Text="",TextColor3=WHITE,Font=FB,TextSize=11,AutoButtonColor=false,TextTruncate=Enum.TextTruncate.AtEnd},row)
		B(chip,"BackgroundColor3","off")
		CO(chip,6)
		local function set(k)
			if cur then
				hot[cur]=nil
				owners[cur]=nil
			end
			cur=k
			if k then
				if owners[k] then owners[k](nil) end
				hot[k]=fn
				owners[k]=set
			end
			chip.Text=k and k.Name or "none"
		end
		chip.MouseButton1Click:Connect(function()
			listening=set
			chip.Text="..."
		end)
		set(def)
	end
	function TOGK(par,text,desc,cb,key,kc,full)
		local api,row=TOG(par,text,desc,cb,key,full)
		KEY(row,kc,api.Toggle)
		return api,row
	end
	local function clickTP(pos)
		local c,r=workspace.CurrentCamera,gR()
		if not c or not r then return end
		local ray=c:ViewportPointToRay(pos.X,pos.Y)
		local rp=RaycastParams.new()
		rp.FilterType=Enum.RaycastFilterType.Exclude
		rp.FilterDescendantsInstances={gC()}
		local res=workspace:Raycast(ray.Origin,ray.Direction*3000,rp)
		if res then
			mark()
			pivot(CFrame.new(res.Position+V3(0,3.5,0)))
			r.AssemblyLinearVelocity=ZERO
		end
	end
	local function worldClick(pos)
		if S.clickTP then clickTP(pos) end
		if S.clickWalk and F.pathClick then F.pathClick(pos) end
		if S.clickDel then
			local n=F.clickDel(pos)
			if n then toast("Hidden: "..n.." (Undo is in the Fun tab)") end
		end
	end
	TK(UIS.TouchTapInWorld:Connect(function(pos,pr) if not pr then worldClick(pos) end end))
	TK(UIS.InputBegan:Connect(function(i,gp)
		if listening then
			if i.UserInputType==Enum.UserInputType.Keyboard then
				local f=listening
				listening=nil
				f(i.KeyCode~=Enum.KeyCode.Escape and i.KeyCode or nil)
			end
			return
		end
		if gp then return end
		if i.KeyCode==Enum.KeyCode.RightControl then
			toggleUI()
			return
		end
		local f=hot[i.KeyCode]
		if f then
			f()
			return
		end
		if i.UserInputType==Enum.UserInputType.MouseButton1 then worldClick(UIS:GetMouseLocation()) end
	end))
	function UI.addSearch(frame,par,key,name)
		srch[#srch+1]={frame,par,key:lower(),name=name}
	end
	function UI.buildAll()
		if UI.onBuilt then task.defer(UI.onBuilt) end
		local P=pages.All
		local pn={}
		for n,p in pairs(pages) do pn[p]=n end
		local snap={}
		for _,e in ipairs(srch) do
			if e.name and e[2]~=P then snap[#snap+1]=e end
		end
		local lastPage
		for _,e in ipairs(snap) do
			if e[2]~=lastPage then
				lastPage=e[2]
				SEC(P,pn[e[2]] or "")
			end
			local row=PNL("TextButton",P,40,e.name.." "..(e.desc or "").." "..(pn[e[2]] or ""))
			LB(row,e.name,U2(1,-96,0,20),UO(12,4),"white",FM,13)
			LB(row,e.api and (e.desc or "") or ("Open in "..(pn[e[2]] or "")),U2(1,-96,0,14),UO(12,22),"muted",FR,10)
			if e.api then
				local pill=N("Frame",{Size=UO(42,22),Position=U2(1,-54,0.5,-11)},row)
				B(pill,"BackgroundColor3",function() return e.api.get() and T.accent or T.off end)
				CO(pill)
				local knob=N("Frame",{Size=UO(18,18),Position=e.api.get() and UO(22,2) or UO(2,2),BackgroundColor3=WHITE},pill)
				CO(knob)
				e.api.watch[#e.api.watch+1]=function(v)
					tw(pill,0.2,{BackgroundColor3=v and T.accent or T.off},ES.Quint)
					tw(knob,0.2,{Position=v and UO(22,2) or UO(2,2)},ES.Back)
				end
				row.MouseButton1Click:Connect(function() e.api.Toggle() end)
			else
				LB(row,">",UO(24,40),U2(1,-30,0,0),"muted",FB,16,XA.Center)
				row.MouseButton1Click:Connect(function()
					local pg=e[2]
					showTab(pn[pg])
					task.spawn(function()
						task.wait(0.1)
						pg.CanvasPosition=Vector2.new(0,math.max(0,e[1].AbsolutePosition.Y-pg.AbsolutePosition.Y+pg.CanvasPosition.Y-6))
					end)
				end)
			end
		end
	end
	local fn,fa=0,0
	TK(RS.Heartbeat:Connect(function(dt)
		fa=fa+dt
		fn=fn+1
		if fa>=1 then
			local fps=math.floor(fn/fa+0.5)
			fn,fa=0,0
			local ping=0
			pcall(function() ping=math.floor(game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue()+0.5) end)
			sub.Text=fps.." FPS  •  "..ping.." ms  •  "..#Pl:GetPlayers().." players"
		end
	end))
end
local function SAFE(name,fn)
	local ok,err=pcall(fn)
	if not ok then
		warn("[Sams Hub] "..name.." failed: "..tostring(err))
		toast(name.." failed: "..tostring(err),"err")
	end
end
F.applyTheme=function(name)
	S.curTheme=name
	for k,v in pairs(TH[name]) do T[k]=v end
	for _,b in ipairs(binds) do
		pcall(function()
			local k=b[3]
			b[1][b[2]]=type(k)=="function" and k() or T[k]
		end)
	end
	local pic=name=="Marin" or name=="Muichiro"
	local img=pic and F.skinImage(name) or ""
	UI.bgImg.Image=img
	UI.bgImg.Visible=img~=""
	if pic and img=="" then toast("Picture failed: needs writefile + getcustomasset, or the pasted data was damaged","err") end
	UI.showTab(S.curTab)
	if F.colorRows then F.colorRows() end
end
do
	local old=F.toast
	F.toast=function(m,k) old((tostring(m):gsub("V6%.5","V7")),k) end
end
do
	local fc,hud,anch,oldT,oldF,ccf,pos,photoGui
	local rotv={x=0,y=0}
	local cn,touches={},{}
	local upH,dnH=false,false
	local function mkHud()
		if hud then return end
		hud=N("Frame",{Size=UO(152,44),Position=U2(0,14,1,-70),BackgroundTransparency=1,Visible=false},UI.gui)
		local function hb(txt,x,w)
			local b=N("TextButton",{Size=UO(w,40),Position=UO(x,2),Text=txt,TextColor3=WHITE,Font=FB,TextSize=16,AutoButtonColor=false,BackgroundTransparency=0.15},hud)
			B(b,"BackgroundColor3","panel")
			CO(b,10)
			return b
		end
		local function hold(b,set)
			b.InputBegan:Connect(function(i)
				if i.UserInputType==Enum.UserInputType.Touch or i.UserInputType==Enum.UserInputType.MouseButton1 then set(true) end
			end)
			b.InputEnded:Connect(function(i)
				if i.UserInputType==Enum.UserInputType.Touch or i.UserInputType==Enum.UserInputType.MouseButton1 then set(false) end
			end)
		end
		hold(hb("▲",0,44),function(v) upH=v end)
		hold(hb("▼",48,44),function(v) dnH=v end)
		hb("Exit",96,52).MouseButton1Click:Connect(function()
			if UI.fcApi then UI.fcApi.Set(false) else F.freecam(false) end
		end)
	end
	function F.freecam(on)
		if fc then fc:Disconnect() fc=nil end
		for _,c in ipairs(cn) do c:Disconnect() end
		table.clear(cn)
		table.clear(touches)
		upH,dnH=false,false
		local cam=workspace.CurrentCamera
		if on then
			if not cam then return false end
			mkHud()
			oldT,oldF=cam.CameraType,cam.FieldOfView
			local cf=cam.CFrame
			local x,y=cf:ToEulerAnglesYXZ()
			rotv.x,rotv.y=x,y
			pos,ccf=cf.Position,cf
			S.fcOn=true
			local r=gR()
			if r and S.fcFreeze~=false then
				r.Anchored=true
				anch=r
			end
			cn[#cn+1]=UIS.InputBegan:Connect(function(i,gp)
				if not gp and i.UserInputType==Enum.UserInputType.Touch then touches[i]=true end
			end)
			cn[#cn+1]=UIS.InputEnded:Connect(function(i) touches[i]=nil end)
			cn[#cn+1]=UIS.InputChanged:Connect(function(i)
				local d
				if i.UserInputType==Enum.UserInputType.Touch and touches[i] then
					d=i.Delta
				elseif i.UserInputType==Enum.UserInputType.MouseMovement and UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
					d=i.Delta
				end
				if d then
					rotv.y=rotv.y-d.X*0.006
					rotv.x=math.clamp(rotv.x-d.Y*0.006,-1.5,1.5)
				end
			end)
			hud.Visible=true
			fc=RS.RenderStepped:Connect(function(dt)
				local c2=workspace.CurrentCamera
				if not c2 then return end
				c2.CameraType=Enum.CameraType.Scriptable
				local cf2=CFrame.fromEulerAnglesYXZ(rotv.x,rotv.y,0)
				local h=gH()
				local mv=h and h.MoveDirection or ZERO
				local d=ZERO
				if mv.Magnitude>0 then
					local lm=CFrame.fromEulerAnglesYXZ(0,rotv.y,0):VectorToObjectSpace(mv)
					d=cf2.RightVector*lm.X-cf2.LookVector*lm.Z
				end
				local up=(h and h.Jump) or upH or UIS:IsKeyDown(Enum.KeyCode.E)
				local dn=dnH or UIS:IsKeyDown(Enum.KeyCode.Q) or UIS:IsKeyDown(Enum.KeyCode.LeftShift)
				d=d+V3(0,(up and 1 or 0)-(dn and 1 or 0),0)
				pos=pos+d*(S.fcSpeed or 40)*dt
				local target=CFrame.new(pos)*cf2
				local sm=S.fcSmooth or 12
				ccf=sm>=30 and target or ccf:Lerp(target,math.clamp(dt*sm,0,1))
				c2.CFrame=ccf
				c2.FieldOfView=S.fcFov or 70
			end)
			return true
		end
		S.fcOn=false
		if hud then hud.Visible=false end
		if anch and anch.Parent then anch.Anchored=false end
		anch=nil
		if cam then
			cam.CameraType=oldT or Enum.CameraType.Custom
			cam.FieldOfView=oldF or 70
			local h=gH()
			if h then cam.CameraSubject=h end
		end
		return true
	end
	function F.fcHere()
		local r=gR()
		if not S.fcOn or not pos then return false,"Turn Freecam on first" end
		if not r then return false,"Your character isn't loaded" end
		mark()
		local was=r.Anchored
		r.Anchored=false
		pivot(CFrame.new(pos))
		r.AssemblyLinearVelocity=ZERO
		r.Anchored=was
		return true
	end
	function F.photo(on)
		S.photoOn=on
		UI.gui.Enabled=not on
		pcall(function() game:GetService("StarterGui"):SetCoreGuiEnabled(Enum.CoreGuiType.All,not on) end)
		if on then
			if not photoGui then
				photoGui=N("ScreenGui",{Name="SamsPhoto",ResetOnSpawn=false,DisplayOrder=1001,IgnoreGuiInset=true},parent)
				local b=N("TextButton",{Size=UO(120,30),Position=U2(1,-130,0,8),BackgroundColor3=Color3.new(0,0,0),BackgroundTransparency=0.6,Text="Exit photo mode",TextColor3=WHITE,Font=FM,TextSize=12},photoGui)
				CO(b,8)
				b.MouseButton1Click:Connect(function()
					F.photo(false)
					if UI.photoApi then UI.photoApi.Set(false,true) end
				end)
			end
			photoGui.Enabled=true
		elseif photoGui then
			photoGui.Enabled=false
		end
	end
	hooks[#hooks+1]=function()
		if S.fcOn then
			if UI.fcApi then UI.fcApi.Set(false) else F.freecam(false) end
		end
	end
	cleanups[#cleanups+1]=function()
		F.freecam(false)
		if S.photoOn then F.photo(false) end
		if hud then hud:Destroy() hud=nil end
		if photoGui then photoGui:Destroy() photoGui=nil end
	end
end
do
	local rd,con
	local dots,sq={},{}
	local function mk()
		if rd then return end
		rd=N("Frame",{Size=UO(150,150),Position=U2(1,-170,0,70),BackgroundColor3=C3(10,10,18),BackgroundTransparency=0.35,ClipsDescendants=true,Active=true,Visible=false},UI.gui)
		CO(rd)
		B(N("UIStroke",{Thickness=2,Transparency=0.2},rd),"Color","accent")
		local ring=N("Frame",{AnchorPoint=Vector2.new(0.5,0.5),Position=US(0.5,0.5),Size=US(0.5,0.5),BackgroundTransparency=1},rd)
		CO(ring)
		N("UIStroke",{Thickness=1,Transparency=0.6,Color=WHITE},ring)
		N("Frame",{AnchorPoint=Vector2.new(0.5,0.5),Position=US(0.5,0.5),Size=U2(1,0,0,1),BackgroundTransparency=0.7,BorderSizePixel=0,BackgroundColor3=WHITE},rd)
		N("Frame",{AnchorPoint=Vector2.new(0.5,0.5),Position=US(0.5,0.5),Size=U2(0,1,1,0),BackgroundTransparency=0.7,BorderSizePixel=0,BackgroundColor3=WHITE},rd)
		local me=N("Frame",{AnchorPoint=Vector2.new(0.5,0.5),Position=US(0.5,0.5),Size=UO(8,8),BorderSizePixel=0,ZIndex=4},rd)
		B(me,"BackgroundColor3","accent")
		CO(me)
		UI.drag(rd,rd)
	end
	local function newDot(p)
		local b=N("TextButton",{AnchorPoint=Vector2.new(0.5,0.5),Size=UO(10,10),Text="",AutoButtonColor=false,BorderSizePixel=0,ZIndex=3},rd)
		CO(b)
		local st=N("UIStroke",{Thickness=2,Color=WHITE,Enabled=false},b)
		local nm=N("TextLabel",{AnchorPoint=Vector2.new(0.5,0),Position=U2(0.5,0,1,0),Size=UO(80,12),BackgroundTransparency=1,Text=p.DisplayName,TextColor3=WHITE,Font=FM,TextSize=10,TextStrokeTransparency=0.5,Visible=false},b)
		b.MouseButton1Click:Connect(function()
			S.selected=p
			if F.colorRows then F.colorRows() end
			local my=gR()
			local c=p.Character and p.Character:FindFirstChild("HumanoidRootPart")
			toast("Selected "..p.DisplayName..((my and c) and ("  ("..math.floor((c.Position-my.Position).Magnitude).." studs)") or ""))
		end)
		dots[p]={b,st,nm}
		return dots[p]
	end
	local function upd()
		local cam=workspace.CurrentCamera
		local my=gR()
		if not cam or not my then return end
		local size=S.rdSize or 150
		rd.Size=UO(size,size)
		rd.BackgroundTransparency=S.rdT or 0.35
		local rad=size/2-6
		local range=S.rdRange or 200
		local look=V3(cam.CFrame.LookVector.X,0,cam.CFrame.LookVector.Z)
		look=look.Magnitude>0 and look.Unit or V3(0,0,-1)
		local right=look:Cross(V3(0,1,0))
		if S.rdRot==false then
			look=V3(0,0,-1)
			right=V3(1,0,0)
		end
		local function place(obj,wp)
			local rel=wp-my.Position
			local x,y=rel:Dot(right),rel:Dot(look)
			local d=math.sqrt(x*x+y*y)
			local sc=rad/range
			local px,py=x*sc,-y*sc
			if d>range then
				px,py=px*range/d,py*range/d
			end
			obj.Position=U2(0.5,px,0.5,py)
			return d>range
		end
		for p,d in pairs(dots) do
			if p.Parent~=Pl then
				d[1]:Destroy()
				dots[p]=nil
			end
		end
		for _,p in ipairs(Pl:GetPlayers()) do
			if p~=LP then
				local c=p.Character
				local r=c and c:FindFirstChild("HumanoidRootPart")
				local d=dots[p] or (r and newDot(p))
				if d then
					d[1].Visible=r~=nil
					if r then
						local far=place(d[1],r.Position)
						d[1].BackgroundColor3=(p.Team and p.TeamColor.Color) or C3(255,90,90)
						d[1].BackgroundTransparency=far and 0.6 or 0
						d[2].Enabled=p==S.selected
						d[3].Visible=S.rdNames==true
					end
				end
			end
		end
		for i=1,3 do
			local c=S.saved[i]
			if c and S.rdSaved~=false then
				local s=sq[i]
				if not s then
					s=N("Frame",{AnchorPoint=Vector2.new(0.5,0.5),Size=UO(8,8),BorderSizePixel=0,Rotation=45,BackgroundColor3=C3(80,170,255),ZIndex=2},rd)
					sq[i]=s
				end
				s.Visible=true
				place(s,c.Position)
			elseif sq[i] then
				sq[i].Visible=false
			end
		end
	end
	function F.radar(on)
		if con then con:Disconnect() con=nil end
		S.rdOn=on
		mk()
		rd.Visible=on
		if on then con=RS.RenderStepped:Connect(upd) end
	end
	function F.radarReset()
		if rd then rd.Position=U2(1,-170,0,70) end
	end
	cleanups[#cleanups+1]=function()
		F.radar(false)
		if rd then rd:Destroy() rd=nil end
	end
end
do
	local C,out,hist={},{},{}
	local logL
	local function say(t)
		out[#out+1]=tostring(t)
		if #out>40 then table.remove(out,1) end
		if logL then logL.Text=table.concat(out,"\n") end
	end
	local function plr(a)
		if not a or a=="" or a=="selected" then return S.selected end
		a=a:lower()
		if a=="me" then return LP end
		if a=="random" then
			local l=Pl:GetPlayers()
			return l[math.random(#l)]
		end
		local best
		for _,p in ipairs(Pl:GetPlayers()) do
			local n,d=p.Name:lower(),p.DisplayName:lower()
			if n==a or d==a then return p end
			if not best and (n:sub(1,#a)==a or d:sub(1,#a)==a) then best=p end
		end
		return best
	end
	local function tog(name,on)
		for _,e in ipairs(UI.srch) do
			if e.api and e.name==name then
				e.api.Set(on)
				return true
			end
		end
		return false
	end
	local function def(names,usage,fn)
		for _,n in ipairs(names) do C[n]={fn=fn,use=usage} end
	end
	local function pick(a)
		local p=plr(a[1])
		if not p then
			say("No player matches \""..tostring(a[1] or "").."\"")
			return nil
		end
		S.selected=p
		if F.colorRows then F.colorRows() end
		return p
	end
	local toggles={{"fly","Fly"},{"noclip","Noclip"},{"infjump","Infinite Jump"},{"airwalk","Air Walk"},{"esp","Enable ESP"},{"aimbot","Aimbot"},{"invis","Invisibility"},{"god","Invincibility"},{"antifling","Anti Fling"},{"autoheal","Auto Heal"},{"ghost","Ghost Players"},{"fullbright","Fullbright"},{"fog","Clear Fog"},{"touchfling","Touch Fling"},{"clicktp","Click Teleport"},{"antivoid","Anti Void"},{"freecam","Freecam"},{"radar","Radar"},{"photo","Photo Mode"},{"hitbox","Hitbox Expander"},{"autoclick","Auto Clicker"},{"rainbow","Rainbow Character"},{"trail","Trail"},{"sparkles","Sparkles"},{"clickwalk","Click Walk"},{"quickbar","Quick Bar"}}
	for _,t in ipairs(toggles) do
		def({t[1]},t[1].."  (turns "..t[2].." on)",function(a)
			if t[1]=="fly" and tonumber(a[1]) then S.flySpeed=tonumber(a[1]) end
			say(tog(t[2],true) and (t[2].." on") or ("Couldn't find the "..t[2].." switch"))
		end)
		def({"un"..t[1]},"un"..t[1].."  (turns "..t[2].." off)",function()
			say(tog(t[2],false) and (t[2].." off") or ("Couldn't find the "..t[2].." switch"))
		end)
	end
	C.clip=C.unnoclip
	C.vis=C.uninvis
	def({"speed","ws"},"speed <number|off>",function(a)
		local n=tonumber(a[1])
		local h=gH()
		if a[1]=="off" then
			S.ws=nil
			if h then h.WalkSpeed=16 end
			say("Speed reset")
		elseif n then
			S.ws=n
			if h then h.WalkSpeed=n end
			say("Speed set to "..n)
		else
			say("Usage: speed <number|off>")
		end
	end)
	def({"jump","jp"},"jump <number|off>",function(a)
		local n=tonumber(a[1])
		local h=gH()
		if a[1]=="off" then
			S.jp=nil
			if h then h.JumpPower=50 end
			say("JumpPower reset")
		elseif n then
			S.jp=n
			if h then
				h.UseJumpPower=true
				h.JumpPower=n
			end
			say("JumpPower set to "..n)
		else
			say("Usage: jump <number|off>")
		end
	end)
	def({"gravity","grav"},"gravity <number|off>",function(a)
		local n=tonumber(a[1])
		if a[1]=="off" then
			S.gr=nil
			workspace.Gravity=196.2
			say("Gravity reset")
		elseif n then
			S.gr=n
			workspace.Gravity=n
			say("Gravity set to "..n)
		else
			say("Usage: gravity <number|off>")
		end
	end)
	def({"fov"},"fov <number|off>",function(a)
		local n=tonumber(a[1])
		if a[1]=="off" then S.fovWant=nil say("FOV released") elseif n then S.fovWant=n say("FOV set to "..n) else say("Usage: fov <number|off>") end
	end)
	def({"time"},"time <0-24|off>",function(a)
		local n=tonumber(a[1])
		if a[1]=="off" then F.tod(nil) say("Time released") elseif n then F.tod(n) say("Time set to "..n) else say("Usage: time <0-24|off>") end
	end)
	def({"tp","goto"},"tp <player>",function(a)
		local p=pick(a)
		if p then
			local ok,err=F.tp(p)
			say(ok and ("Teleported to "..p.DisplayName) or err)
		end
	end)
	def({"view"},"view <player>",function(a)
		local p=pick(a)
		if p then say(tog("Spectate Selected",true) and ("Viewing "..p.DisplayName) or "Spectate switch not found") end
	end)
	def({"unview"},"unview",function() say(tog("Spectate Selected",false) and "Stopped viewing" or "Spectate switch not found") end)
	def({"follow"},"follow <player>",function(a)
		local p=pick(a)
		if p then say(tog("Follow Selected",true) and ("Following "..p.DisplayName) or "Follow switch not found") end
	end)
	def({"unfollow"},"unfollow",function() say(tog("Follow Selected",false) and "Stopped following" or "Follow switch not found") end)
	def({"orbit"},"orbit <player>",function(a)
		local p=pick(a)
		if p then say(tog("Orbit Selected",true) and ("Orbiting "..p.DisplayName) or "Orbit switch not found") end
	end)
	def({"unorbit"},"unorbit",function() say(tog("Orbit Selected",false) and "Stopped orbiting" or "Orbit switch not found") end)
	def({"select"},"select <player>",function(a)
		local p=pick(a)
		if p then say("Selected "..p.DisplayName) end
	end)
	def({"walkto"},"walkto <player>",function(a)
		local p=pick(a)
		local r=p and p.Character and p.Character:FindFirstChild("HumanoidRootPart")
		if r then
			local ok,err=F.walkTo(r.Position)
			say(ok and ("Walking to "..p.DisplayName) or err)
		elseif p then
			say(p.DisplayName.." isn't loaded")
		end
	end)
	def({"stopwalk"},"stopwalk",function() F.walkStop() say("Stopped walking") end)
	def({"slot"},"slot <1-3>  (teleport to a saved location)",function(a)
		local ok,err=F.tpSaved(tonumber(a[1]) or 1)
		say(ok and "Teleported" or err)
	end)
	def({"back"},"back",function()
		local ok,err=F.back()
		say(ok and "Went back" or err)
	end)
	def({"spawn"},"spawn",function()
		local ok,err=F.tpSpawn()
		say(ok and "Teleported to spawn" or err)
	end)
	def({"random"},"random  (teleport to a random player)",function()
		local p,err=F.randomTP()
		say(p and ("Teleported to "..p.DisplayName) or err)
	end)
	def({"heal"},"heal",function()
		local h=gH()
		if h then h.Health=h.MaxHealth end
		say("Healed")
	end)
	def({"reset","re"},"reset",function()
		local h=gH()
		if h then h.Health=0 end
		say("Resetting")
	end)
	def({"sit"},"sit",function()
		local h=gH()
		if h then h.Sit=true end
		say("Sitting")
	end)
	def({"freeze"},"freeze",function() say(F.freeze(true) and "Frozen" or "Character not loaded") end)
	def({"thaw","unfreeze"},"thaw",function() say(F.freeze(false) and "Unfrozen" or "Character not loaded") end)
	def({"emote"},"emote <name>",function(a)
		local q=table.concat(a," "):lower()
		local names={"Backflip","Take the L","Spin"}
		for _,e in ipairs(F.emotes) do names[#names+1]=e[1] end
		for _,n in ipairs(names) do
			if n:lower():sub(1,#q)==q and q~="" then
				local r=F.emote(n)
				say(r and (n.." "..r) or ("Couldn't play "..n))
				return
			end
		end
		say("Emotes: "..table.concat(names,", "))
	end)
	def({"rejoin"},"rejoin",function()
		say("Rejoining...")
		pcall(function() game:GetService("TeleportService"):Teleport(game.PlaceId,LP) end)
	end)
	def({"hop"},"hop [small]",function(a)
		say("Looking for a server...")
		task.spawn(function() if not F.hop(a[1]=="small") then say("Couldn't find another server") end end)
	end)
	def({"record","rec"},"record  (start recording your path)",function()
		say(F.recStart() and "Recording... use stoprec to save" or "Couldn't start recording")
	end)
	def({"stoprec"},"stoprec  (saves into the selected slot)",function()
		local n=F.recStop()
		say(n>0 and ("Saved "..n.." points to slot "..(S.rtSlot or 1)) or "Nothing recorded")
	end)
	def({"play"},"play <1-3> [exact] [loop]",function(a)
		local mode,loop="Walk",false
		for _,w in ipairs(a) do
			if w=="exact" then mode="Exact" end
			if w=="loop" then loop=true end
		end
		local ok,err=F.routePlay(tonumber(a[1]) or S.rtSlot or 1,mode,loop)
		say(ok and "Playing route" or err)
	end)
	def({"stopplay"},"stopplay",function() F.routeStop() say("Stopped route") end)
	def({"clear"},"clear",function()
		table.clear(out)
		if logL then logL.Text="" end
	end)
	local function names()
		local l={}
		for n in pairs(C) do l[#l+1]=n end
		table.sort(l)
		return l
	end
	def({"help","cmds"},"help",function()
		say("Commands: "..table.concat(names(),", "))
		say("Players: type a name or the start of one. Also me, random, selected.")
	end)
	local function run(text)
		text=(text:gsub("^[;/%s]+",""):gsub("%s+$",""))
		if text=="" then return end
		say("> "..text)
		for i=#hist,1,-1 do
			if hist[i]==text then table.remove(hist,i) end
		end
		hist[#hist+1]=text
		if #hist>8 then table.remove(hist,1) end
		local parts={}
		for w in text:gmatch("%S+") do parts[#parts+1]=w end
		local c=C[table.remove(parts,1):lower()]
		if not c then
			say("Unknown command. Type help")
			return
		end
		local ok,err=pcall(c.fn,parts)
		if not ok then say("Error: "..tostring(err)) end
	end
	F.cmd=run
	F.cmdNames=names
	F.cmdHist=hist
	F.cmdSay=say
	F.cmdUse=function(n) return C[n] and C[n].use end
	F.cmdLog=function(l) logL=l end
	F.cmdLogText=function() return table.concat(out,"\n") end
end
do
	local rec,recData,recT0
	S.routes={}
	local PS=game:GetService("PathfindingService")
	local function fileOf(i) return "samshub_route"..i.."_"..game.PlaceId..".json" end
	for i=1,3 do
		pcall(function()
			if isfile(fileOf(i)) then S.routes[i]=HS:JSONDecode(readfile(fileOf(i))) end
		end)
	end
	function F.recing() return rec~=nil end
	function F.recCount() return recData and #recData or 0 end
	function F.recStart()
		if rec or not gR() then return false end
		recData={}
		recT0=os.clock()
		local last=-1
		rec=RS.Heartbeat:Connect(function()
			local r,h=gR(),gH()
			if not r then return end
			local now=os.clock()-recT0
			if now-last<0.1 then return end
			last=now
			local j=(h and h:GetState()==Enum.HumanoidStateType.Jumping) and 1 or 0
			recData[#recData+1]={math.floor(r.Position.X*10)/10,math.floor(r.Position.Y*10)/10,math.floor(r.Position.Z*10)/10,j,math.floor(now*100)/100}
			if #recData>=3000 then
				local n=F.recStop()
				toast("Recording hit the 5 minute limit and was saved ("..n.." points)","warn")
			end
		end)
		return true
	end
	function F.recStop()
		if rec then
			rec:Disconnect()
			rec=nil
		end
		local d=recData
		recData=nil
		local slot=S.rtSlot or 1
		if d and #d>=2 then
			S.routes[slot]=d
			pcall(function() writefile(fileOf(slot),HS:JSONEncode(d)) end)
			return #d
		end
		return 0
	end
	function F.routeDel(i)
		S.routes[i]=nil
		pcall(function()
			if isfile(fileOf(i)) then
				if delfile then delfile(fileOf(i)) else writefile(fileOf(i),"[]") end
			end
		end)
	end
	function F.routeInfo(i)
		local rt=S.routes[i]
		if not rt or #rt<2 then return nil end
		return #rt,rt[#rt][5]
	end
	local walkTok=0
	function F.routeStop()
		S.rpTok=(S.rpTok or 0)+1
		S.rpOn=false
		walkTok=walkTok+1
		local h,r=gH(),gR()
		if h and r then h:MoveTo(r.Position) end
	end
	function F.routePlay(i,mode,loop)
		local rt=S.routes[i]
		if not rt or #rt<2 then return false,"Slot "..i.." is empty" end
		F.routeStop()
		local tok=S.rpTok
		S.rpOn=true
		task.spawn(function()
			repeat
				local r0=gR()
				if r0 and (r0.Position-V3(rt[1][1],rt[1][2],rt[1][3])).Magnitude>8 and S.rtStart~=false then
					mark()
					pivot(CFrame.new(rt[1][1],rt[1][2]+3,rt[1][3]))
					task.wait(0.3)
				end
				if mode=="Exact" then
					local t0=os.clock()
					local total=rt[#rt][5]
					local idx=1
					while tok==S.rpTok do
						local r=gR()
						if not r then break end
						local el=(os.clock()-t0)*(S.rtSpeed or 1)
						if el>=total then break end
						while idx<#rt-1 and rt[idx+1][5]<el do idx=idx+1 end
						local a,b=rt[idx],rt[idx+1]
						local f=(el-a[5])/math.max(b[5]-a[5],0.001)
						local p=V3(a[1]+(b[1]-a[1])*f,a[2]+(b[2]-a[2])*f,a[3]+(b[3]-a[3])*f)
						local look=V3(b[1]-a[1],0,b[3]-a[3])
						S.grace=os.clock()+0.5
						r.CFrame=look.Magnitude>0.01 and CFrame.lookAt(p,p+look) or CFrame.new(p)
						r.AssemblyLinearVelocity=ZERO
						RS.Heartbeat:Wait()
					end
				else
					local idx=1
					while tok==S.rpTok and idx<#rt do
						local h,r=gH(),gR()
						if not h or not r then break end
						local tgt,jmp=idx,false
						while tgt<#rt do
							tgt=tgt+1
							if rt[tgt][4]==1 then jmp=true end
							if (V3(rt[tgt][1],0,rt[tgt][3])-V3(rt[idx][1],0,rt[idx][3])).Magnitude>=6 then break end
						end
						local tp=V3(rt[tgt][1],rt[tgt][2],rt[tgt][3])
						if jmp then h.Jump=true end
						h:MoveTo(tp)
						local t0=os.clock()
						while tok==S.rpTok do
							local rr=gR()
							if not rr then break end
							if (V3(rr.Position.X,0,rr.Position.Z)-V3(tp.X,0,tp.Z)).Magnitude<4 then break end
							if os.clock()-t0>2.5 then
								if S.rtAssist~=false then
									S.grace=os.clock()+0.5
									pivot(CFrame.new(tp+V3(0,3,0)))
								end
								break
							end
							task.wait(0.1)
						end
						idx=tgt
					end
				end
			until not loop or tok~=S.rpTok
			if tok==S.rpTok then S.rpOn=false end
		end)
		return true
	end
	local prev={}
	function F.routePreview(i,on)
		for _,p in ipairs(prev) do p:Destroy() end
		table.clear(prev)
		S.rtPrev=on
		local rt=S.routes[i]
		if not on or not rt then return end
		local step=math.max(1,math.floor(#rt/250))
		for k=1,#rt,step do
			local p=rt[k]
			prev[#prev+1]=N("Part",{Shape=Enum.PartType.Ball,Size=V3(1,1,1),Anchored=true,CanCollide=false,CanQuery=false,CanTouch=false,Material=Enum.Material.Neon,Color=T.accent,Position=V3(p[1],p[2]-2,p[3])},workspace)
		end
	end
	function F.walkTo(target)
		local h,r=gH(),gR()
		if not h or not r then return false,"Your character isn't loaded" end
		walkTok=walkTok+1
		local tok=walkTok
		task.spawn(function()
			local path=PS:CreatePath({AgentRadius=2,AgentHeight=5,AgentCanJump=true,AgentCanClimb=true})
			local ok=pcall(function() path:ComputeAsync(r.Position,target) end)
			if not ok or path.Status~=Enum.PathStatus.Success then
				toast("No walkable path found","warn")
				return
			end
			toast("Walking there...")
			for _,wp in ipairs(path:GetWaypoints()) do
				if tok~=walkTok then return end
				local hh=gH()
				if not hh then return end
				if wp.Action==Enum.PathWaypointAction.Jump then hh.Jump=true end
				hh:MoveTo(wp.Position)
				local t0=os.clock()
				while tok==walkTok do
					local rr=gR()
					if not rr or (rr.Position-wp.Position).Magnitude<=4 or os.clock()-t0>3 then break end
					task.wait(0.1)
				end
			end
		end)
		return true
	end
	function F.walkStop()
		walkTok=walkTok+1
		local h,r=gH(),gR()
		if h and r then h:MoveTo(r.Position) end
	end
	function F.pathClick(pos)
		local c=workspace.CurrentCamera
		if not c then return end
		local ray=c:ViewportPointToRay(pos.X,pos.Y)
		local rp=RaycastParams.new()
		rp.FilterType=Enum.RaycastFilterType.Exclude
		rp.FilterDescendantsInstances={gC()}
		local res=workspace:Raycast(ray.Origin,ray.Direction*3000,rp)
		if res then F.walkTo(res.Position) end
	end
	cleanups[#cleanups+1]=function()
		if rec then rec:Disconnect() rec=nil end
		F.routeStop()
		F.routePreview(1,false)
	end
end
SAFE("Camera",function()
	local P=UI.Camera
	SEC(P,"Freecam")
	local api=TOGK(P,"Freecam","Fly the camera anywhere. Joystick moves, drag the screen to look",function(on)
		if not F.freecam(on) then
			toast("Camera not ready","err")
			return false
		end
		toast(on and "Freecam on. Use the buttons at the bottom left to go up, down or exit" or "Freecam off")
	end,nil,Enum.KeyCode.C)
	UI.fcApi=api
	SLD(P,"Camera speed",5,300,40,function(v) S.fcSpeed=v end,function() S.fcSpeed=40 end,"fcs")
	SLD(P,"Smoothness",1,30,12,function(v) S.fcSmooth=v end,function() S.fcSmooth=12 end,"fcm")
	SLD(P,"Freecam FOV",20,120,70,function(v) S.fcFov=v end,function() S.fcFov=70 end,"fcf")
	TOG(P,"Freeze my character","Keeps you still while the camera flies",function(on) S.fcFreeze=on end,"fcz",true).Set(true,true)
	BTN(P,"Move my character to the camera",function()
		local ok,err=F.fcHere()
