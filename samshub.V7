	N("TextLabel",{Size=UO(26,30),Position=UO(2,0),BackgroundTransparency=1,Text="🔍",TextSize=13,TextColor3=WHITE,Font=FM},sbox)
	local search=N("TextBox",{Size=UO(SW-32,30),Position=UO(28,0),BackgroundTransparency=1,Text="",PlaceholderText="Search",TextColor3=WHITE,Font=FB,TextSize=13,TextXAlignment=XA.Left,ClearTextOnFocus=false},sbox)
