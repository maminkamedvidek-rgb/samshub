	local vp=workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1280,720)
	local W,H,SW=math.clamp(vp.X-90,440,620),math.clamp(vp.Y-50,320,420),134
	local main=N("CanvasGroup",{Size=UO(W,H),AnchorPoint=Vector2.new(0.5,0.5),Position=US(0.5,0.5),Visible=false,GroupTransparency=1,BackgroundTransparency=0.06},gui)
