SAFE("Console",function()
	local P=UI.Console
	SEC(P,"Command console")
	local box=N("TextBox",{Size=U2(1,-8,0,38),Text="",PlaceholderText="Type a command, for example  speed 80  (try help)",PlaceholderColor3=T.muted,TextColor3=WHITE,Font=FB,TextSize=14,ClearTextOnFocus=false,TextXAlignment=XA.Left,BackgroundTransparency=0.2,LayoutOrder=NO()},P)
	B(box,"BackgroundColor3","panel")
	CO(box,10)
	N("UIPadding",{PaddingLeft=UDim.new(0,10)},box)
	local sug=N("Frame",{Size=U2(1,-8,0,0),AutomaticSize=Enum.AutomaticSize.Y,BackgroundTransparency=1,LayoutOrder=NO()},P)
	N("UIListLayout",{FillDirection=Enum.FillDirection.Horizontal,Wraps=true,Padding=UDim.new(0,4),SortOrder=Enum.SortOrder.LayoutOrder},sug)
	local function chip(text,fn)
		local b=N("TextButton",{AutomaticSize=Enum.AutomaticSize.X,Size=UO(0,26),Text="  "..text.."  ",TextColor3=WHITE,Font=FM,TextSize=12,AutoButtonColor=false},sug)
		B(b,"BackgroundColor3","off")
		CO(b,8)
		b.MouseButton1Click:Connect(fn)
	end
	local function refresh()
		for _,c in ipairs(sug:GetChildren()) do
			if c:IsA("TextButton") then c:Destroy() end
		end
		local tok=box.Text:match("^[;/%s]*(%S*)"):lower()
		if tok=="" then
			local h=F.cmdHist
			for i=#h,math.max(1,#h-5),-1 do
				local t=h[i]
				chip(t,function()
					F.cmd(t)
					box.Text=""
				end)
			end
		elseif not box.Text:find("%s") then
			local n=0
			for _,name in ipairs(F.cmdNames()) do
				if name:sub(1,#tok)==tok then
					n=n+1
					if n>6 then break end
					chip(name,function()
						box.Text=name.." "
						box:CaptureFocus()
					end)
				end
			end
		else
			local use=F.cmdUse(tok)
			if use then chip(use,function() end) end
		end
	end
	box:GetPropertyChangedSignal("Text"):Connect(refresh)
	box.FocusLost:Connect(function(enter)
		if enter then
			F.cmd(box.Text)
			box.Text=""
		end
		refresh()
	end)
	BTN(P,"Run",function()
		F.cmd(box.Text)
		box.Text=""
		refresh()
	end)
	local log=LB(P,F.cmdLogText(),U2(1,-8,0,0),nil,"muted",Enum.Font.Code,12)
	log.LayoutOrder=NO()
	log.AutomaticSize=Enum.AutomaticSize.Y
	log.TextWrapped=true
	log.TextTruncate=Enum.TextTruncate.None
	log.TextYAlignment=Enum.TextYAlignment.Top
	F.cmdLog(log)
	if log.Text=="" then F.cmdSay("Sams Hub console ready. Type help to see every command.") end
	refresh()
end)
SAFE("Routes",function()
	local P=UI.Routes
	SEC(P,"Click to walk (pathfinding)")
	TOGK(P,"Click Walk","Tap or click the world and your character walks there around obstacles",function(on) S.clickWalk=on end,"cw")
	BTN(P,"Walk to selected player",function()
		local p=S.selected
		local r=p and p.Character and p.Character:FindFirstChild("HumanoidRootPart")
		if not p then toast("Select a player in Teleport first","warn") return end
		if not r then toast(p.DisplayName.." isn't loaded","warn") return end
		local ok,err=F.walkTo(r.Position)
		if not ok then toast(err,"err") end
	end,"accent2")
	BTN(P,"Stop walking",function()
		F.walkStop()
		toast("Stopped walking")
	end,"off")
	SEC(P,"Record a route")
	DDN(P,"Save into slot",{"1","2","3"},function() return tostring(S.rtSlot or 1) end,function(v) S.rtSlot=tonumber(v) end)
	local stat=LB(P,"Not recording",U2(1,-8,0,18),nil,"muted",FM,12)
	stat.LayoutOrder=NO()
	BTN(P,"Start recording",function(b)
		if F.recing() then
			local n=F.recStop()
			b.Text="Start recording"
			if n>0 then toast("Saved "..n.." points to slot "..(S.rtSlot or 1)) else toast("That was too short to save","warn") end
		else
			if F.recStart() then
				b.Text="Stop and save"
				toast("Recording. Walk your route, then tap Stop and save")
			else
				toast("Character not loaded","err")
			end
		end
	end)
	SEC(P,"Saved routes")
	local slotL={}
	local function slotText(i)
		local n,t=F.routeInfo(i)
		return n and ("Slot "..i..": "..n.." points, "..math.floor(t).."s") or ("Slot "..i..": empty")
	end
	for i=1,3 do
		local row=N("Frame",{Size=U2(1,-8,0,40),BackgroundTransparency=0.2,LayoutOrder=NO()},P)
		B(row,"BackgroundColor3","panel")
		CO(row,10)
		slotL[i]=LB(row,slotText(i),U2(1,-130,1,0),UO(10,0),"white",FM,12)
		local function mk(txt,x,w,ck,fn)
			local b=N("TextButton",{Size=UO(w,26),Position=U2(1,x,0.5,-13),Text=txt,TextColor3=WHITE,Font=FB,TextSize=12,AutoButtonColor=false},row)
			B(b,"BackgroundColor3",ck)
			CO(b,8)
			b.MouseButton1Click:Connect(function() fn(b) end)
		end
		mk("Show",-118,50,"accent2",function(b)
			local on=not S.rtPrev or S.rtPrevSlot~=i
			S.rtPrevSlot=on and i or nil
			F.routePreview(i,on)
			toast(on and "Showing route "..i.." in the world (only you see it)" or "Route preview off")
		end)
		mk("Del",-62,54,"off",function()
			F.routeDel(i)
			slotL[i].Text=slotText(i)
			toast("Slot "..i.." deleted")
		end)
		UI.addSearch(row,P,"saved routes slot "..i,"Saved route "..i)
	end
	task.spawn(function()
		while stat.Parent do
			if F.recing() then
				stat.Text="Recording... "..F.recCount().." points"
			else
				stat.Text=S.rpOn and "Playing a route..." or "Not recording"
			end
			for i=1,3 do slotL[i].Text=slotText(i) end
			task.wait(0.4)
		end
	end)
	SEC(P,"Play a route")
	local playSlot,mode=1,"Walk"
	DDN(P,"Play slot",{"1","2","3"},function() return tostring(playSlot) end,function(v) playSlot=tonumber(v) end)
	DDN(P,"Mode",{"Walk","Exact"},function() return mode end,function(v) mode=v end)
	local loopOn=false
	TOG(P,"Loop","Start again when the route ends",function(on) loopOn=on end)
	TOG(P,"Walk to the start first","Teleports to the route start if you're far from it",function(on) S.rtStart=on end,"rts",true).Set(true,true)
	TOG(P,"Assist when stuck","Walk mode jumps ahead if you get stuck",function(on) S.rtAssist=on end,"rta",true).Set(true,true)
	SLD(P,"Exact mode speed",50,300,100,function(v) S.rtSpeed=v/100 end,function() S.rtSpeed=1 end)
	BTN(P,"Play route",function()
		local ok,err=F.routePlay(playSlot,mode,loopOn)
		if ok then toast("Playing slot "..playSlot.." ("..mode..")") else toast(err,"warn") end
	end)
	BTN(P,"Stop route",function()
		F.routeStop()
		toast("Route stopped")
	end,"off")
end)
SAFE("Quick",function()
	local P=UI.Quick
	local pins,btns,watchers={},{},{}
	local bar=N("Frame",{AutomaticSize=Enum.AutomaticSize.XY,Size=UO(0,0),Position=U2(0,76,0.5,-90),BackgroundTransparency=1,Visible=false},UI.gui)
	local lay=N("UIListLayout",{Padding=UDim.new(0,4),SortOrder=Enum.SortOrder.LayoutOrder,FillDirection=Enum.FillDirection.Vertical},bar)
	local handle=N("TextButton",{Size=UO(34,18),Text="::",TextColor3=WHITE,Font=FB,TextSize=14,AutoButtonColor=false,BackgroundTransparency=0.2,LayoutOrder=0},bar)
	B(handle,"BackgroundColor3","panel")
	CO(handle,8)
	UI.drag(handle,bar)
	local rows={}
	local function find(name)
		for _,e in ipairs(UI.srch) do
			if e.api and e.name==name then return e end
		end
	end
	local function refreshRows()
		for _,r in ipairs(rows) do r.refresh() end
	end
	local function rebuild()
		for _,w in ipairs(watchers) do
			for i,f in ipairs(w[1].watch) do
				if f==w[2] then
					table.remove(w[1].watch,i)
					break
				end
			end
		end
		table.clear(watchers)
		for _,b in ipairs(btns) do b:Destroy() end
		table.clear(btns)
		local sz=S.qbSize or 40
		for i,name in ipairs(pins) do
			local e=find(name)
			if e then
				local b=N("TextButton",{Size=UO(S.qbWide and 96 or sz,sz),Text=name,TextWrapped=true,TextColor3=WHITE,Font=FB,TextSize=10,AutoButtonColor=false,BackgroundTransparency=0.15,LayoutOrder=i},bar)
				CO(b,10)
				local function paint(v) tw(b,0.15,{BackgroundColor3=v and T.accent or T.off}) end
				b.BackgroundColor3=e.api.get() and T.accent or T.off
				local f=function(v) paint(v) end
				e.api.watch[#e.api.watch+1]=f
				watchers[#watchers+1]={e.api,f}
				b.MouseButton1Click:Connect(function() e.api.Toggle() end)
				btns[#btns+1]=b
			end
		end
		bar.Visible=S.qbOn~=false and #btns>0
	end
	function F.quickBar(on)
		S.qbOn=on
		rebuild()
		return true
	end
	function F.quickPin(name)
		for i,n in ipairs(pins) do
			if n==name then
				table.remove(pins,i)
				rebuild()
				refreshRows()
				queueSave()
				return false
			end
		end
		if #pins>=8 then
			toast("The quick bar holds up to 8 switches","warn")
			return nil
		end
		pins[#pins+1]=name
		rebuild()
		refreshRows()
		queueSave()
		return true
	end
	reg("qpins",1,function() return pins end,function(v)
		if type(v)=="table" then
			pins=v
			rebuild()
			refreshRows()
		end
	end)
	SEC(P,"Quick bar")
	TOGK(P,"Quick Bar","A small bar of your favorite switches that stays on screen",function(on) F.quickBar(on) end,"qbon",Enum.KeyCode.B,true).Set(true,true)
	SLD(P,"Button size",30,64,40,function(v)
		S.qbSize=v
		rebuild()
	end,function()
		S.qbSize=40
		rebuild()
	end,"qbs")
	TOG(P,"Wide buttons","Longer buttons so names fit",function(on)
		S.qbWide=on
		rebuild()
	end,"qbw")
	TOG(P,"Horizontal bar","Lay the buttons out in a row",function(on)
		lay.FillDirection=on and Enum.FillDirection.Horizontal or Enum.FillDirection.Vertical
	end,"qbh")
	BTN(P,"Clear all pins",function()
		table.clear(pins)
		rebuild()
		refreshRows()
		queueSave()
		toast("Quick bar cleared")
	end,"off")
	local hint=SEC(P,"Pin your switches (tap Pin)")
	local sb=N("TextBox",{Size=U2(1,-8,0,34),Text="",PlaceholderText="Search switches...",PlaceholderColor3=T.muted,TextColor3=WHITE,Font=FM,TextSize=13,ClearTextOnFocus=false,BackgroundTransparency=0.2,LayoutOrder=NO()},P)
	B(sb,"BackgroundColor3","panel")
	CO(sb,10)
	UI.onBuilt=function()
		local seen={}
		local order=1000
		for _,e in ipairs(UI.srch) do
			if e.api and e.name and not seen[e.name] then
				seen[e.name]=true
				order=order+1
				local row=N("Frame",{Size=U2(1,-8,0,36),BackgroundTransparency=0.2,LayoutOrder=order},P)
				B(row,"BackgroundColor3","panel")
				CO(row,10)
				LB(row,e.name,U2(1,-86,1,0),UO(10,0),"white",FM,13)
				local pb=N("TextButton",{Size=UO(66,24),Position=U2(1,-72,0.5,-12),Text="Pin",TextColor3=WHITE,Font=FB,TextSize=12,AutoButtonColor=false},row)
				CO(pb,8)
				local name=e.name
				local function refresh()
					local on=false
					for _,n in ipairs(pins) do
						if n==name then on=true end
					end
					pb.Text=on and "Pinned" or "Pin"
					pb.BackgroundColor3=on and T.accent or T.off
				end
				refresh()
				pb.MouseButton1Click:Connect(function() F.quickPin(name) end)
				rows[#rows+1]={frame=row,name=name:lower(),refresh=refresh}
			end
		end
		sb:GetPropertyChangedSignal("Text"):Connect(function()
			local q=sb.Text:lower()
			for _,r in ipairs(rows) do r.frame.Visible=q=="" or r.name:find(q,1,true)~=nil end
		end)
		rebuild()
	end
	cleanups[#cleanups+1]=function() bar:Destroy() end
end)
SAFE("Main",function()
	local P=UI.Main
	SEC(P,"Movement")
	local bs,bj=16,50
	local h0=gH()
	if h0 then bs,bj=h0.WalkSpeed,h0.JumpPower end
	local function typed(title,desc,key,def,kc,apply,restore)
		local val,state=def,false
		local api,row=TOG(P,title,desc,function(on)
			state=on
			if on then apply(val) else restore() end
		end,key)
		local box=N("TextBox",{Size=UO(70,28),Position=U2(1,S.hasKb and -190 or -130,0.5,-14),Text=tostring(def),TextColor3=WHITE,Font=FB,TextSize=14,ClearTextOnFocus=false},row)
		B(box,"BackgroundColor3","off")
		CO(box,8)
		local function set(n)
			val=n
			box.Text=tostring(n)
			if state then apply(n) end
		end
		box.FocusLost:Connect(function()
			local n=tonumber(box.Text)
			if n then
				set(n)
				queueSave()
			else
				box.Text=tostring(val)
			end
		end)
		reg(key.."V",1,function() return val end,set)
		KEY(row,kc,api.Toggle)
	end
	typed("WalkSpeed","Any number, no limit","sp",50,Enum.KeyCode.Z,function(n)
		S.ws=n
		local h=gH()
		if h then h.WalkSpeed=n end
	end,function()
		S.ws=nil
		local h=gH()
		if h then h.WalkSpeed=bs end
	end)
	SLD(P,"JumpPower",0,500,math.floor(bj+0.5),function(v)
		S.jp=v
		local h=gH()
		if h then
			h.UseJumpPower=true
			h.JumpPower=v
		end
	end,function()
		S.jp=nil
		local h=gH()
		if h then h.JumpPower=bj end
	end,"jump")
	local g0=workspace.Gravity
	typed("Gravity","Any number, 196 is normal","gr",100,Enum.KeyCode.X,function(n)
		S.gr=n
		workspace.Gravity=n
	end,function()
		S.gr=nil
		workspace.Gravity=g0
	end)
	cleanups[#cleanups+1]=function() workspace.Gravity=g0 end
	TK(RS.Heartbeat:Connect(function()
		if S.gr and workspace.Gravity~=S.gr then workspace.Gravity=S.gr end
		local h=gH()
		if not h then return end
		if S.ws and h.WalkSpeed~=S.ws then h.WalkSpeed=S.ws end
		if S.jp then
			if not h.UseJumpPower then h.UseJumpPower=true end
			if h.JumpPower~=S.jp then h.JumpPower=S.jp end
		end
		if S.es and S.cm and h.MoveDirection.Magnitude>0 then F.stopEmote() end
	end))
	TOGK(P,"Infinite Jump","Jump again while in the air",function(on) S.infJump=on end,"ij",Enum.KeyCode.J)
	TOGK(P,"Auto Jump","Keeps hopping while you move",function(on) F.autoJump(on) end,"aj")
	local fly=TOGK(P,"Fly","Jump or E = up, Shift or Q = down",function(on)
		if not F.fly(on) then
			toast("Character not loaded","err")
			return false
		end
	end,nil,Enum.KeyCode.F)
	SLD(P,"Fly speed",10,300,S.flySpeed,function(v) S.flySpeed=v end,nil,"flySpeed")
	TOGK(P,"Noclip","Walk through walls",function(on) F.noclip(on) end,nil,Enum.KeyCode.N)
	local air=TOGK(P,"Air Walk","Walk on air, you won't fall",function(on)
		if not F.air(on) then
			toast("Character not loaded","err")
			return false
		end
		toast(on and "Air Walk on" or "Air Walk off")
	end,nil,Enum.KeyCode.Y)
	SLD(P,"Air height",-60,60,0,function(v) S.airOff=v end,function() S.airOff=0 end)
	TOGK(P,"Click Teleport","Tap or click the world to teleport there",function(on) S.clickTP=on end,"ctp",Enum.KeyCode.T)
	TOGK(P,"Anti Void","Brings you back if you fall out of the map",function(on) F.antiVoid(on) end,"av")
	SEC(P,"Players")
	TOGK(P,"Touch Fling","Walk into players to launch them",function(on) F.fling(on) end,nil,Enum.KeyCode.K)
	TOG(P,"Auto Heal","Heals you when your HP drops under half",function(on) F.autoHeal(on) end,"ah")
	TOG(P,"Ghost Players","Walk through other players",function(on) F.ghostPlayers(on) end,"gp")
	local function heal()
		local h=gH()
		if h then h.Health=h.MaxHealth end
		toast("Healed")
	end
	KEY(BTN(P,"Heal",function() heal() end),Enum.KeyCode.H,heal)
	hooks[#hooks+1]=function()
		if S.flying then
			F.fly(false)
			fly.Set(false,true)
		end
		if S.airOn then
			F.air(false)
			air.Set(false,true)
		end
	end
end)
SAFE("ESP",function()
	local P=UI.ESP
	local op=S.opts
	SEC(P,"ESP")
	TOGK(P,"Enable ESP","Highlights every other player",function(on) F.esp(on) end,"esp",Enum.KeyCode.G)
	SEC(P,"Options")
	TOG(P,"Chams","Glowing outline through walls",function(on) op.chams=on end,"chams",true).Set(true,true)
	TOG(P,"Name / Distance / HP","Info and health bar above heads",function(on) op.info=on end,"info",true).Set(true,true)
	TOG(P,"Tracers",F.hasDraw and "Lines to each player" or "Not supported by your executor",function(on)
		if not F.hasDraw then
			toast("Tracers need Drawing support","warn")
			return false
		end
		op.tracers=on
	end,"tracers")
	TOG(P,"Team colors","Use each team's color",function(on) op.team=on end,"team")
	SLD(P,"Max distance",100,5000,op.maxDist,function(v) op.maxDist=v end,nil,"espDist")
	SLD(P,"Fill strength",0,100,45,function(v) op.fillT=1-v/100 end,function() op.fillT=0.55 end)
