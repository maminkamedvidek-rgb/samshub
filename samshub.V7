local Pl=game:GetService("Players")
local RS=game:GetService("RunService")
local UIS=game:GetService("UserInputService")
local TS=game:GetService("TweenService")
local HS=game:GetService("HttpService")
local Lt=game:GetService("Lighting")
local LP=Pl.LocalPlayer
local U2,UO,US,V3,C3=UDim2.new,UDim2.fromOffset,UDim2.fromScale,Vector3.new,Color3.fromRGB
local XA=Enum.TextXAlignment
local FB,FM,FR,FK=Enum.Font.GothamBold,Enum.Font.GothamMedium,Enum.Font.Gotham,Enum.Font.GothamBlack
local ES,ED,ZERO=Enum.EasingStyle,Enum.EasingDirection,Vector3.zero
local WHITE=Color3.new(1,1,1)
local GUI_NAME,CFG="SamsHubV65","samshub_v65.json"
if _G.SamsHubCleanup then pcall(_G.SamsHubCleanup) end
local conns,hooks,cleanups={},{},{}
local function TK(c) conns[#conns+1]=c return c end
local S={flySpeed=60,grace=0,aimStr=60,aimRad=250,aimWall=true,curTab="Main",curTheme="Default",nh1=300,nh2=180,opts={chams=true,info=true,tracers=false,team=false,maxDist=3000,fillT=0.55},airOff=0,uiScale=1,saved={},hasKb=UIS.KeyboardEnabled}
local F,UI={},{}
local parent
do
	local ok,ui=false,nil
	if gethui then ok,ui=pcall(gethui) end
	parent=(ok and ui) or LP:WaitForChild("PlayerGui")
	for _,root in ipairs({parent,LP:FindFirstChild("PlayerGui")}) do
		for _,n in ipairs({GUI_NAME,"SamsHubV6","SamsHubV56","SamsHubV55","SamsHubV5","SamsHubV45","SamsHubV4"}) do
			local o=root:FindFirstChild(n)
			if o then o:Destroy() end
		end
	end
end
local function N(c,p,par)
	local o=Instance.new(c)
	for k,v in pairs(p or {}) do o[k]=v end
	if par then o.Parent=par end
	return o
end
local function CO(o,r) N("UICorner",{CornerRadius=r and UDim.new(0,r) or UDim.new(1,0)},o) end
local function tw(o,t,p,s,d) TS:Create(o,TweenInfo.new(t,s or ES.Quad,d or ED.Out),p):Play() end
local function gC() return LP.Character end
local function gH() local c=LP.Character return c and c:FindFirstChildOfClass("Humanoid") end
local function gR() local c=LP.Character return c and c:FindFirstChild("HumanoidRootPart") end
local function rot(cf) return CFrame.fromMatrix(ZERO,cf.XVector,cf.YVector,cf.ZVector) end
local pc=setmetatable({},{__mode="k"})
local function partsOf(c)
	local e=pc[c]
	if not e or os.clock()-e.t>0.5 then
		e={t=os.clock()}
		for _,d in ipairs(c:GetDescendants()) do
			if d:IsA("BasePart") then e[#e+1]=d end
		end
		pc[c]=e
	end
	return e
end
local TH={
Default={bg=C3(52,43,122),panel=C3(88,76,170),off=C3(112,100,195),accent=C3(160,138,255),accent2=C3(110,150,255),muted=C3(196,188,238)},
Marin={bg=C3(40,14,30),panel=C3(72,26,54),off=C3(110,48,86),accent=C3(255,95,175),accent2=C3(255,160,205),muted=C3(235,175,210)},
Muichiro={bg=C3(7,22,28),panel=C3(13,44,54),off=C3(26,72,84),accent=C3(50,205,185),accent2=C3(70,150,225),muted=C3(150,210,215)},
Old={bg=C3(34,24,12),panel=C3(62,44,20),off=C3(94,66,30),accent=C3(214,158,46),accent2=C3(176,82,34),muted=C3(205,178,120)},
}
local function neonTheme()
	local a,b,H=S.nh1/360,S.nh2/360,Color3.fromHSV
	return {bg=H(a,0.75,0.07),panel=H(a,0.65,0.14),off=H(a,0.5,0.24),accent=H(a,1,1),accent2=H(b,1,1),muted=H(b,0.3,0.92)}
end
TH.Neon=neonTheme()
local T={}
for k,v in pairs(TH.Default) do T[k]=v end
local binds={}
local function B(o,p,k)
	binds[#binds+1]={o,p,k}
	o[p]=type(k)=="function" and k() or T[k]
end
local function grad(o,r) B(N("UIGradient",{Rotation=r or 45},o),"Color",function() return ColorSequence.new(T.accent,T.accent2) end) end
local cfg={}
pcall(function() if isfile(CFG) then cfg=HS:JSONDecode(readfile(CFG)) end end)
if type(cfg)~="table" then cfg={} end
S.saveOn=cfg.saveOn==true
local regs,tok={},0
local function saveNow()
	if not S.saveOn then return end
	local o={saveOn=true}
	for k,r in pairs(regs) do o[k]=r.get() end
	pcall(function() writefile(CFG,HS:JSONEncode(o)) end)
end
local function queueSave()
	tok=tok+1
	local t=tok
	task.delay(0.8,function() if t==tok then saveNow() end end)
end
local function reg(k,o,g,s) regs[k]={get=g,set=s,o=o} end
local function toast(m,k) if F.toast then F.toast(m,k) end end
local function pivot(cf)
	S.grace=os.clock()+0.7
	local c=gC()
	if c then c:PivotTo(cf) end
end
local function mark()
	local r=gR()
	if r then S.prev=r.CFrame end
end
do
	local fc,bv,bg,nc
	local no=setmetatable({},{__mode="k"})
	function F.fly(on)
		if fc then fc:Disconnect() fc=nil end
		if bv then bv:Destroy() bv=nil end
		if bg then bg:Destroy() bg=nil end
		S.flying=on
		local r,h=gR(),gH()
		if h then h.PlatformStand=on and true or false end
		if not on then return true end
		if not r or not h then
			S.flying=false
			return false
		end
		bv=N("BodyVelocity",{MaxForce=V3(1e9,1e9,1e9),Velocity=ZERO},r)
		bg=N("BodyGyro",{MaxTorque=V3(1e9,1e9,1e9),P=9e4,CFrame=r.CFrame},r)
		fc=RS.RenderStepped:Connect(function()
			local hh,c=gH(),workspace.CurrentCamera
			if not hh or not c or not gR() or not bv or not bg then return F.fly(false) end
			local d=ZERO
			local mv=hh.MoveDirection
			if mv.Magnitude>0 then
				local lm=c.CFrame:VectorToObjectSpace(mv)
				d=c.CFrame:VectorToWorldSpace(V3(lm.X,0,lm.Z))
			end
			if hh.Jump or UIS:IsKeyDown(Enum.KeyCode.E) then d=d+V3(0,1,0) end
			if UIS:IsKeyDown(Enum.KeyCode.LeftShift) or UIS:IsKeyDown(Enum.KeyCode.Q) then d=d-V3(0,1,0) end
			bv.Velocity=d.Magnitude>0 and d.Unit*S.flySpeed or ZERO
			bg.CFrame=c.CFrame
		end)
		return true
	end
	function F.noclip(on)
		if nc then nc:Disconnect() nc=nil end
		S.ncOn=on
		if on then
			nc=RS.Stepped:Connect(function()
				local c=gC()
				if not c then return end
				for _,p in ipairs(partsOf(c)) do
					if no[p]==nil then no[p]=p.CanCollide end
					p.CanCollide=false
				end
			end)
		else
			for p,v in pairs(no) do if p.Parent then p.CanCollide=v end end
			table.clear(no)
		end
	end
	TK(UIS.JumpRequest:Connect(function()
		if S.infJump then
			local h=gH()
			if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end
		end
	end))
	function F.fling(on)
		if (not not on)==(not not S.flinging) then return end
		S.flinging=on
		if on then
			task.spawn(function()
				local j=0.1
				while S.flinging do
					RS.Heartbeat:Wait()
					local r=gR()
					if r then
						local v=r.AssemblyLinearVelocity
						r.AssemblyLinearVelocity=v*10000+V3(0,10000,0)
						RS.RenderStepped:Wait()
						r.AssemblyLinearVelocity=v
						RS.Stepped:Wait()
						r.AssemblyLinearVelocity=v+V3(0,j,0)
						j=-j
					end
				end
			end)
		else
			task.defer(function()
				local r=gR()
				if r then r.AssemblyLinearVelocity=ZERO end
			end)
		end
	end
	hooks[#hooks+1]=function() table.clear(no) end
	cleanups[#cleanups+1]=function()
		F.fly(false)
		F.fling(false)
		F.noclip(false)
	end
end
do
	local pf,ac,base,av,ground,aj,z0,orig,fcn,q0
	local ct0=Lt.ClockTime
	local function feet(h,r) return r.Position.Y-(h.RigType==Enum.HumanoidRigType.R6 and 3 or h.HipHeight+r.Size.Y/2) end
	function F.air(on)
		if ac then ac:Disconnect() ac=nil end
		if pf then pf:Destroy() pf=nil end
		S.airOn=on
		if not on then return true end
		local h,r=gH(),gR()
		if not h or not r then
			S.airOn=false
			return false
		end
		base=feet(h,r)
		pf=N("Part",{Name="SamAir",Size=V3(12,1,12),Anchored=true,CanCollide=true,Transparency=1,CanQuery=false,CanTouch=false},workspace)
		ac=RS.Heartbeat:Connect(function()
			local rr=gR()
			if rr and pf then pf.CFrame=CFrame.new(rr.Position.X,base+S.airOff-0.5,rr.Position.Z) end
		end)
		return true
	end
	function F.antiVoid(on)
		if av then av:Disconnect() av=nil end
		if not on then return end
		av=RS.Heartbeat:Connect(function()
			local h,r=gH(),gR()
			if not h or not r then return end
			if h.FloorMaterial~=Enum.Material.Air and r.AssemblyLinearVelocity.Magnitude<80 then ground=r.CFrame end
			if ground and r.Position.Y<workspace.FallenPartsDestroyHeight+120 then
				pivot(ground+V3(0,4,0))
				r.AssemblyLinearVelocity=ZERO
			end
		end)
	end
	function F.autoJump(on)
		if aj then aj:Disconnect() aj=nil end
		if on then
			aj=RS.Heartbeat:Connect(function()
				local h=gH()
				if h and h.FloorMaterial~=Enum.Material.Air and h.MoveDirection.Magnitude>0 then h:ChangeState(Enum.HumanoidStateType.Jumping) end
			end)
		end
	end
	function F.zoom(on)
		if on then
			z0=LP.CameraMaxZoomDistance
			LP.CameraMaxZoomDistance=2000
		else
			LP.CameraMaxZoomDistance=z0 or 128
		end
	end
	local K={"Brightness","ClockTime","FogEnd","GlobalShadows","Ambient","OutdoorAmbient"}
	local V={2,14,1e5,false,C3(178,178,178),C3(178,178,178)}
	function F.fullbright(on)
		S.fbOn=on
		if on then
			orig={}
			for _,k in ipairs(K) do orig[k]=Lt[k] end
		elseif orig then
			for k,v in pairs(orig) do Lt[k]=v end
		end
	end
	TK(RS.Heartbeat:Connect(function()
		if S.fbOn then
			for i,k in ipairs(K) do Lt[k]=V[i] end
		end
		if S.tod then Lt.ClockTime=S.tod end
	end))
	TK(LP.Idled:Connect(function()
		if S.antiAfk then
			pcall(function()
				local vu=game:GetService("VirtualUser")
				vu:CaptureController()
				vu:ClickButton2(Vector2.new())
			end)
		end
	end))
	function F.follow(on)
		if fcn then fcn:Disconnect() fcn=nil end
		S.follow=on
		if not on then return end
		local last=0
		fcn=RS.Heartbeat:Connect(function()
			if os.clock()-last<0.2 then return end
			last=os.clock()
			local p,h=S.selected,gH()
			local c=p and p.Character
			local t=c and c:FindFirstChild("HumanoidRootPart")
			if h and t then h:MoveTo(t.Position) end
		end)
	end
	function F.tod(v)
		local was=S.tod
		S.tod=v
		if v then Lt.ClockTime=v elseif was then Lt.ClockTime=ct0 end
	end
	function F.lowGfx(on)
		pcall(function()
			local r=settings().Rendering
			if on then
				q0=q0 or r.QualityLevel
				r.QualityLevel=Enum.QualityLevel.Level01
				Lt.GlobalShadows=false
			elseif q0 then
				r.QualityLevel=q0
				Lt.GlobalShadows=true
			end
		end)
	end
	function F.hop(small)
		local ok,res=pcall(function()
			local data=HS:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/"..game.PlaceId.."/servers/Public?sortOrder=Asc&limit=100"))
			local list={}
			for _,s in ipairs(data.data) do
				if s.id~=game.JobId and s.playing<s.maxPlayers then list[#list+1]=s end
			end
			if #list==0 then return nil end
			local pick
			if small then
				table.sort(list,function(a,b) return a.playing<b.playing end)
				pick=list[1]
			else
				pick=list[math.random(#list)]
			end
			game:GetService("TeleportService"):TeleportToPlaceInstance(game.PlaceId,pick.id,LP)
			return true
		end)
		return ok and res
	end
	hooks[#hooks+1]=function() ground=nil end
	cleanups[#cleanups+1]=function()
		F.air(false)
		F.antiVoid(false)
		F.autoJump(false)
		F.fullbright(false)
		F.follow(false)
		F.lowGfx(false)
		F.tod(nil)
		if z0 then F.zoom(false) end
	end
end
do
	local rb,rbo=nil,setmetatable({},{__mode="k"})
	function F.rainbow(on)
		if rb then rb:Disconnect() rb=nil end
		for p,v in pairs(rbo) do if p.Parent then p.Color=v end end
		table.clear(rbo)
		if on then
			rb=RS.Heartbeat:Connect(function()
				local c=gC()
				if not c then return end
				local col=Color3.fromHSV((os.clock()*0.3)%1,0.8,1)
				for _,p in ipairs(partsOf(c)) do
					if p.Name~="HumanoidRootPart" then
						if rbo[p]==nil then rbo[p]=p.Color end
						p.Color=col
					end
				end
			end)
		end
	end
	local tr,a0,a1,sp
	function F.trail(on)
		S.trOn=on
		if tr then tr:Destroy() tr=nil end
		if a0 then a0:Destroy() a0=nil end
		if a1 then a1:Destroy() a1=nil end
		if not on then return true end
		local r=gR()
		if not r then return false end
		a0=N("Attachment",{Position=V3(0,1,0)},r)
		a1=N("Attachment",{Position=V3(0,-1,0)},r)
		tr=N("Trail",{Attachment0=a0,Attachment1=a1,Lifetime=0.8,Color=ColorSequence.new(T.accent,T.accent2),Transparency=NumberSequence.new(0.2,1),LightEmission=1},r)
		return true
	end
	function F.sparkle(on)
		S.spOn=on
		if sp then sp:Destroy() sp=nil end
		if not on then return true end
		local r=gR()
		if not r then return false end
		sp=N("ParticleEmitter",{Rate=35,Lifetime=NumberRange.new(0.8,1.4),Speed=NumberRange.new(1,4),SpreadAngle=Vector2.new(180,180),Size=NumberSequence.new(0.35,0),LightEmission=1,Color=ColorSequence.new(T.accent,T.accent2)},r)
		return true
	end
	local dc,dco
	function F.disco(on)
		if dc then dc:Disconnect() dc=nil end
		if on then
			dco=dco or {Lt.Ambient,Lt.OutdoorAmbient}
			local last=0
			dc=RS.Heartbeat:Connect(function()
				if os.clock()-last<0.15 then return end
				last=os.clock()
				local c=Color3.fromHSV(math.random(),0.85,1)
				Lt.Ambient=c
				Lt.OutdoorAmbient=c
			end)
		elseif dco then
			Lt.Ambient,Lt.OutdoorAmbient=dco[1],dco[2]
			dco=nil
		end
	end
	function F.freeze(on)
		local r=gR()
		if not r then return false end
		r.Anchored=on
		S.frozen=on
		return true
	end
	local hb,hbo,hbt=nil,setmetatable({},{__mode="k"}),setmetatable({},{__mode="k"})
	function F.hitbox(on)
		if hb then hb:Disconnect() hb=nil end
		for p,v in pairs(hbo) do
			if p.Parent then
				p.Size=v
				p.Transparency=hbt[p] or 1
			end
		end
		table.clear(hbo)
		table.clear(hbt)
		if on then
			hb=RS.Heartbeat:Connect(function()
				local s=S.hbSize or 8
				for _,pl in ipairs(Pl:GetPlayers()) do
					local c=pl~=LP and pl.Character
					local r=c and c:FindFirstChild("HumanoidRootPart")
					if r then
						if hbo[r]==nil then
							hbo[r]=r.Size
							hbt[r]=r.Transparency
						end
						r.Size=V3(s,s,s)
						r.Transparency=0.8
						r.CanCollide=false
					end
				end
			end)
		end
	end
	function F.autoClick(on)
		S.acOn=on
		if on and not S.acRun then
			S.acRun=true
			task.spawn(function()
				while S.acOn do
					local c=gC()
					local t=c and c:FindFirstChildOfClass("Tool")
					if t then pcall(function() t:Activate() end) end
					task.wait(S.acInt or 0.1)
				end
				S.acRun=false
			end)
		end
	end
	local ob,ang0=nil,0
	function F.orbit(on)
		if ob then ob:Disconnect() ob=nil end
		S.orbitOn=on
		if not on then return end
		ob=RS.Heartbeat:Connect(function(dt)
			local p=S.selected
			local c=p and p.Character
			local t=c and c:FindFirstChild("HumanoidRootPart")
			local r=gR()
			if not t or not r then return end
			ang0=ang0+dt*2.2
			local rad=S.orbitR or 8
			S.grace=os.clock()+0.5
			r.CFrame=CFrame.lookAt(t.Position+V3(math.cos(ang0)*rad,2,math.sin(ang0)*rad),t.Position)
			r.AssemblyLinearVelocity=ZERO
		end)
	end
	function F.randomTP()
		local list={}
		for _,p in ipairs(Pl:GetPlayers()) do
			if p~=LP and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then list[#list+1]=p end
		end
		if #list==0 then return nil,"No other players are loaded" end
		local p=list[math.random(#list)]
		local ok,err=F.tp(p)
		if ok then return p end
		return nil,err
	end
	local stack={}
	function F.clickDel(pos)
		local c=workspace.CurrentCamera
		if not c then return nil end
		local ray=c:ViewportPointToRay(pos.X,pos.Y)
		local rp=RaycastParams.new()
		rp.FilterType=Enum.RaycastFilterType.Exclude
		rp.FilterDescendantsInstances={gC()}
		local res=workspace:Raycast(ray.Origin,ray.Direction*3000,rp)
		local p=res and res.Instance
		if p and not p:IsA("Terrain") and p.Parent then
			stack[#stack+1]={p,p.Parent}
			p.Parent=nil
			return p.Name
		end
	end
	function F.undoDel()
		local e=table.remove(stack)
		if e and e[2] and e[2].Parent then
			e[1].Parent=e[2]
			return true
		end
		return false
	end
	local vol0,fp0
	function F.mute(on)
		pcall(function()
			local g=UserSettings():GetService("UserGameSettings")
			if on then
				vol0=vol0 or g.MasterVolume
				g.MasterVolume=0
			elseif vol0 then
				g.MasterVolume=vol0
			end
		end)
	end
	function F.fpLock(on)
		if on then
			fp0=LP.CameraMode
			LP.CameraMode=Enum.CameraMode.LockFirstPerson
		elseif fp0 then
			LP.CameraMode=fp0
		end
	end
	hooks[#hooks+1]=function()
		tr,a0,a1,sp=nil,nil,nil,nil
		table.clear(rbo)
		task.delay(1,function()
			if S.trOn then F.trail(true) end
			if S.spOn then F.sparkle(true) end
		end)
	end
	cleanups[#cleanups+1]=function()
		F.rainbow(false)
		F.trail(false)
		F.sparkle(false)
		F.disco(false)
		if S.frozen then F.freeze(false) end
		F.hitbox(false)
		S.acOn=false
		F.orbit(false)
		F.mute(false)
		F.fpLock(false)
	end
end
do
	local ah
	function F.autoHeal(on)
		if ah then ah:Disconnect() ah=nil end
		if on then
			ah=RS.Heartbeat:Connect(function()
				local h=gH()
				if h and h.Health>0 and h.MaxHealth~=math.huge and h.Health<h.MaxHealth*0.5 then h.Health=h.MaxHealth end
			end)
		end
	end
	local gp,gps=nil,setmetatable({},{__mode="k"})
	function F.ghostPlayers(on)
		if gp then gp:Disconnect() gp=nil end
		for p in pairs(gps) do if p.Parent then p.CanCollide=true end end
		table.clear(gps)
		if on then
			gp=RS.Stepped:Connect(function()
				for _,pl in ipairs(Pl:GetPlayers()) do
					local c=pl~=LP and pl.Character
					if c then
						for _,part in ipairs(partsOf(c)) do
							if part.CanCollide then
								gps[part]=true
								part.CanCollide=false
							end
						end
					end
				end
			end)
		end
	end
	local fg,fe0,ad0
	function F.clearFog(on)
		if fg then fg:Disconnect() fg=nil end
		local a=Lt:FindFirstChildOfClass("Atmosphere")
		if on then
			fe0,ad0=Lt.FogEnd,a and a.Density
			fg=RS.Heartbeat:Connect(function()
				Lt.FogEnd=1e6
				if a and a.Parent then a.Density=0 end
			end)
		elseif fe0 then
			Lt.FogEnd=fe0
			if a and ad0 then a.Density=ad0 end
			fe0=nil
		end
	end
	local ja1,ja2
	function F.joinAlerts(on)
		if ja1 then ja1:Disconnect() ja1=nil end
		if ja2 then ja2:Disconnect() ja2=nil end
		if on then
			ja1=Pl.PlayerAdded:Connect(function(p) toast(p.DisplayName.." joined") end)
			ja2=Pl.PlayerRemoving:Connect(function(p) toast(p.DisplayName.." left") end)
		end
	end
	local mk={}
	function F.markers(on)
		for _,m in pairs(mk) do m:Destroy() end
		table.clear(mk)
		S.mkOn=on
		if not on then return end
		for i=1,3 do
			local c=S.saved[i]
			if c then
				local part=N("Part",{Anchored=true,CanCollide=false,CanQuery=false,CanTouch=false,Transparency=1,Size=V3(1,1,1),CFrame=c},workspace)
				local bb=N("BillboardGui",{Size=UO(80,24),StudsOffset=V3(0,3,0),AlwaysOnTop=true,Adornee=part},part)
				N("TextLabel",{Size=US(1,1),BackgroundTransparency=1,Text="Slot "..i,TextColor3=WHITE,TextStrokeTransparency=0.3,Font=FB,TextSize=14},bb)
				mk[i]=part
			end
		end
	end
	local ar
	function F.autoRejoin(on)
		if ar then ar:Disconnect() ar=nil end
		if on then
			pcall(function()
				local po=game:GetService("CoreGui"):WaitForChild("RobloxPromptGui",5):WaitForChild("promptOverlay",5)
				ar=po.ChildAdded:Connect(function(c)
					if c.Name=="ErrorPrompt" then
						task.wait(1)
						game:GetService("TeleportService"):Teleport(game.PlaceId,LP)
					end
				end)
			end)
		end
		return ar~=nil or not on
	end
	function F.scanRemotes()
		local out,n={},0
		for _,nm in ipairs({"ReplicatedStorage","ReplicatedFirst","Workspace"}) do
			local ok,list=pcall(function() return game:GetService(nm):GetDescendants() end)
			if ok then
				for _,d in ipairs(list) do
					n=n+1
					if n%1500==0 then task.wait() end
					if d:IsA("RemoteEvent") or d:IsA("RemoteFunction") then out[#out+1]=d end
				end
			end
		end
		table.sort(out,function(a,b) return a.Name:lower()<b.Name:lower() end)
		return out
	end
	cleanups[#cleanups+1]=function()
		F.autoHeal(false)
		F.ghostPlayers(false)
		F.clearFog(false)
		F.joinAlerts(false)
		F.markers(false)
		F.autoRejoin(false)
	end
end
do
	local af,safe,saved=nil,nil,setmetatable({},{__mode="k"})
	function F.antiFling(on)
		if af then af:Disconnect() af=nil end
		for p in pairs(saved) do if p.Parent then p.CanCollide=true end end
		table.clear(saved)
		safe=nil
		local h0=gH()
		if h0 then pcall(function()
			h0:SetStateEnabled(Enum.HumanoidStateType.FallingDown,not on)
			h0:SetStateEnabled(Enum.HumanoidStateType.Ragdoll,not on)
		end) end
		if not on then return end
		af=RS.Stepped:Connect(function()
			for _,p in ipairs(Pl:GetPlayers()) do
				local c=p~=LP and p.Character
				if c then
					for _,part in ipairs(partsOf(c)) do
						if part.CanCollide then
							saved[part]=true
							part.CanCollide=false
						end
					end
				end
			end
			local r,h=gR(),gH()
			if not r or not h then return end
			if S.flinging or S.godBusy or os.clock()<S.grace then
				safe=r.Position
				return
			end
			local v=r.AssemblyLinearVelocity
			local lim=math.max(120,h.WalkSpeed*3,h.JumpPower*2.5,S.flying and S.flySpeed*3 or 0)
			if Vector3.new(v.X,0,v.Z).Magnitude>lim or v.Y>lim or r.AssemblyAngularVelocity.Magnitude>40 then
				r.AssemblyLinearVelocity=ZERO
				r.AssemblyAngularVelocity=ZERO
				if safe and (r.Position-safe).Magnitude>25 then pivot(CFrame.new(safe)*rot(r.CFrame)) end
			else
				safe=r.Position
			end
		end)
	end
	local ac,last,chr,lt
	function F.aac(on)
		if ac then ac:Disconnect() ac=nil end
		last=nil
		if not on then return end
		ac=RS.Heartbeat:Connect(function(dt)
			local r,h=gR(),gH()
			if gC()~=chr then
				chr=gC()
				last=nil
			end
			if not r or not h or S.godBusy or S.busy or h.Health<=0 or h.SeatPart or os.clock()<S.grace then
				last=r and r.CFrame or nil
				return
			end
			local now=r.CFrame
			if last and (now.Position-last.Position).Magnitude>25+r.AssemblyLinearVelocity.Magnitude*dt*4 then
				r.CFrame=last
				r.AssemblyLinearVelocity=ZERO
				if os.clock()-(lt or 0)>1 then
					lt=os.clock()
					toast("Forced teleport blocked, you're back where you were","warn")
				end
				return
			end
			last=now
		end)
	end
	hooks[#hooks+1]=function()
		safe,last=nil,nil
		if af then
			task.spawn(function()
				task.wait(0.5)
				F.antiFling(true)
			end)
		end
	end
	cleanups[#cleanups+1]=function()
		F.antiFling(false)
		F.aac(false)
	end
end
do
	local function stop()
		if S.es then pcall(S.es) end
		S.es,S.ce,S.cm=nil,nil,false
	end
	F.stopEmote=stop
	local function arc(a,b)
		local c,d=a:Cross(b),a:Dot(b)
		if c.Magnitude<1e-4 then return d>0 and CFrame.new() or CFrame.Angles(math.pi,0,0) end
		return CFrame.fromAxisAngle(c.Unit,math.acos(math.clamp(d,-1,1)))
	end
	local function joint(c,side,kind)
		for _,d in ipairs(c:GetDescendants()) do
			if d:IsA("Motor6D") then
				local n=d.Name:lower():gsub("[^%a]","")
				if n:find(side) and n:find(kind) then return d end
				if kind=="shoulder" and d.Part1 then
					local m=d.Part1.Name:lower():gsub("[^%a]","")
					if m==side.."arm" or m==side.."upperarm" then return d end
				end
			end
		end
	end
	local function setDir(m,o,d)
		local rest=rot(o*m.C1:Inverse())*V3(0,-1,0)
		m.C0=CFrame.new(o.Position)*arc(rest,d.Unit)*rot(o)
		return rot(m.C0*m.C1:Inverse())
	end
	local E={}
	E.Backflip=function()
		local h,r=gH(),gR()
		if not h or not r or S.flying then return false end
		stop()
		local alive=true
		local look=V3(r.CFrame.LookVector.X,0,r.CFrame.LookVector.Z)
		look=look.Magnitude>0 and look.Unit or V3(0,0,-1)
		local axis=r.CFrame.RightVector
		task.spawn(function()
			S.grace=os.clock()+1.2
			h.PlatformStand=true
			r.AssemblyLinearVelocity=V3(0,60,0)-look*8
			local t0=os.clock()
			while alive and os.clock()-t0<0.62 do
				r.AssemblyAngularVelocity=axis*10.2
				RS.Heartbeat:Wait()
			end
			r.AssemblyAngularVelocity=ZERO
			local p=r.Position
			r.CFrame=CFrame.lookAt(p,p+look)
			h.PlatformStand=false
			S.es,S.ce=nil,nil
		end)
		S.es=function() alive=false end
		S.ce,S.cm="Backflip",false
		return true
	end
	E.Spin=function()
		local h=gH()
		if not h or not gR() then return false end
		stop()
		h.AutoRotate=false
		local con=RS.Heartbeat:Connect(function()
			local r=gR()
			if r then r.CFrame=r.CFrame*CFrame.Angles(0,math.rad(24),0) end
		end)
		S.es=function()
			con:Disconnect()
			h.AutoRotate=true
		end
		S.ce,S.cm="Spin",true
		return true
	end
	E["Take the L"]=function()
		local c=gC()
		if not c then return false end
		local sr,sl=joint(c,"right","shoulder"),joint(c,"left","shoulder")
		if not sr or not sl then return false end
		local er,el=joint(c,"right","elbow"),joint(c,"left","elbow")
		stop()
		local o={}
		for _,m in pairs({sr,sl,er,el}) do o[m]=m.C0 end
		local t0=os.clock()
		local con=RS.RenderStepped:Connect(function()
			local s=math.sin((os.clock()-t0)*8)*0.12
			local o1=setDir(sr,o[sr],V3(0.15,0.05,-1))
			local o2=setDir(sl,o[sl],(er and el) and V3(-0.15,0.05,-1) or V3(0,1,0))
			if er and el then
				setDir(er,o[er],o1:VectorToObjectSpace(V3(0,1,s)))
				setDir(el,o[el],o2:VectorToObjectSpace(V3(0,1,-s)))
			end
		end)
		S.es=function()
			con:Disconnect()
			for m,v in pairs(o) do m.C0=v end
		end
		S.ce,S.cm="Take the L",true
		return true
	end
	local EM={{"Dance 1",507771019,182435998},{"Dance 2",507776043,182436842},{"Dance 3",507777268,182436935},{"Wave",507770239,128777973},{"Cheer",507770677,129423030}}
	F.emotes=EM
	for _,e in ipairs(EM) do
		E[e[1]]=function()
			local h=gH()
			if not h then return false end
			stop()
			local a=Instance.new("Animation")
			a.AnimationId="rbxassetid://"..(h.RigType==Enum.HumanoidRigType.R15 and e[2] or e[3])
			local ok,tr=pcall(function() return (h:FindFirstChildOfClass("Animator") or h):LoadAnimation(a) end)
			if not ok or not tr then return false end
			tr.Priority=Enum.AnimationPriority.Action4
			tr.Looped=true
			tr:Play()
			S.es=function() tr:Stop() end
			S.ce,S.cm=e[1],true
			return true
		end
	end
	function F.emote(n)
		if S.ce==n then
			stop()
			return "stopped"
		end
		return E[n]() and "started"
	end
	hooks[#hooks+1]=stop
	cleanups[#cleanups+1]=stop
end
do
	local ic,joint,jpar,body
	local ot=setmetatable({},{__mode="k"})
	local function find(c)
		local lt=c:FindFirstChild("LowerTorso")
		local m=lt and lt:FindFirstChild("Root")
		if m and m:IsA("Motor6D") then return m,lt end
		local hrp=c:FindFirstChild("HumanoidRootPart")
		local tor=c:FindFirstChild("Torso")
		local rj=hrp and hrp:FindFirstChild("RootJoint")
		if rj and tor then return rj,tor end
	end
	local function restore()
		if joint and body and body.Parent then
			local r=gR()
			if r then body.CFrame=r.CFrame end
			if jpar and jpar.Parent then joint.Parent=jpar end
		end
		joint,jpar,body=nil,nil,nil
		for p,v in pairs(ot) do if p.Parent then p.Transparency=v end end
		table.clear(ot)
	end
	function F.invis(on)
		if ic then ic:Disconnect() ic=nil end
		restore()
		S.invisOn=on
		local h=gH()
		if h then h.DisplayDistanceType=on and Enum.HumanoidDisplayDistanceType.None or Enum.HumanoidDisplayDistanceType.Viewer end
		if not on then return true end
		local c,r=gC(),gR()
		if not c or not r then return false end
		local m,bp=find(c)
		if m then
			jpar,joint,body=m.Parent,m,bp
			m.Parent=nil
			ic=RS.Heartbeat:Connect(function()
				local rr=gR()
				if not rr or not body or not body.Parent then return end
				body.CFrame=CFrame.new(rr.Position.X,math.max(workspace.FallenPartsDestroyHeight+60,-3000),rr.Position.Z)
				body.AssemblyLinearVelocity=ZERO
				body.AssemblyAngularVelocity=ZERO
			end)
			return "split"
		end
		ic=RS.Heartbeat:Connect(function()
			local ch=gC()
			if not ch then return end
			for _,p in ipairs(partsOf(ch)) do
				if p.Name~="HumanoidRootPart" then
					if ot[p]==nil then ot[p]=p.Transparency end
					p.Transparency=1
				end
			end
			local hd=ch:FindFirstChild("Head")
			local fd=hd and hd:FindFirstChildOfClass("Decal")
			if fd then
				if ot[fd]==nil then ot[fd]=fd.Transparency end
				fd.Transparency=1
			end
		end)
		return "ghost"
	end
	hooks[#hooks+1]=function()
		joint,jpar,body=nil,nil,nil
		table.clear(ot)
		if S.invisOn then
			task.spawn(function()
				task.wait(0.8)
				if S.invisOn then F.invis(true) end
			end)
		end
	end
	cleanups[#cleanups+1]=function() F.invis(false) end
end
do
	local gc,safe,origMax,lastHp,dmgT,dodgeT=nil,nil,nil,nil,0,0
	function F.god(on)
		if gc then gc:Disconnect() gc=nil end
		local h0=gH()
		local was=origMax~=nil
		if on and not was then
			origMax=h0 and h0.MaxHealth or 100
			if origMax==math.huge then origMax=100 end
		end
		if h0 then pcall(function()
			h0:SetStateEnabled(Enum.HumanoidStateType.Dead,not on)
			if not on and was then
				h0.MaxHealth=origMax
				h0.Health=h0.MaxHealth
			end
		end) end
		if not on then
			origMax,lastHp=nil,nil
			return
		end
		gc=RS.Heartbeat:Connect(function()
			local h,r=gH(),gR()
			if not h or not r then return end
			local hp=h.Health
			if hp~=math.huge then
				if lastHp and hp<lastHp-0.5 then
					dmgT=os.clock()
					if safe then
						pivot(safe+V3(0,3,0))
						r.AssemblyLinearVelocity=ZERO
						if os.clock()-dodgeT>1.5 then
							dodgeT=os.clock()
							toast("Damage dodged, moved to your last safe spot","warn")
						end
					end
				end
				lastHp=hp
			end
			pcall(function()
				h:SetStateEnabled(Enum.HumanoidStateType.Dead,false)
				if h.MaxHealth~=math.huge then h.MaxHealth=math.huge end
				if h.Health~=math.huge then h.Health=math.huge end
			end)
			if os.clock()-dmgT>2 and h.FloorMaterial~=Enum.Material.Air and r.AssemblyLinearVelocity.Magnitude<80 then safe=r.CFrame end
			if safe and r.Position.Y<workspace.FallenPartsDestroyHeight+80 then
				pivot(safe+V3(0,4,0))
				r.AssemblyLinearVelocity=ZERO
			end
		end)
	end
	hooks[#hooks+1]=function() safe,lastHp=nil,nil end
	cleanups[#cleanups+1]=function() F.god(false) end
end
do
	local con
	local obj={}
	local hasDraw=type(Drawing)=="table" and Drawing.new~=nil
	F.hasDraw=hasDraw
	function F.clearESP(p)
		local o=obj[p]
		if o then
			pcall(function()
				o.hl:Destroy()
				o.bb:Destroy()
			end)
			if o.line then pcall(function() o.line:Remove() end) end
			obj[p]=nil
		end
	end
	local function ensure(p)
		local c=p.Character
		local head=c and c:FindFirstChild("Head")
		local rt=c and c:FindFirstChild("HumanoidRootPart")
		local hm=c and c:FindFirstChildOfClass("Humanoid")
		if not (head and rt and hm) then
			F.clearESP(p)
			return nil
		end
		local o=obj[p]
		if o and (o.c~=c or not o.hl.Parent or not o.bb.Parent) then
			F.clearESP(p)
			o=nil
		end
		if not o then
			local hl=N("Highlight",{FillColor=C3(255,70,70),FillTransparency=0.55,OutlineColor=WHITE,DepthMode=Enum.HighlightDepthMode.AlwaysOnTop,Adornee=c},c)
			local bb=N("BillboardGui",{Size=UO(150,46),StudsOffset=V3(0,3.2,0),AlwaysOnTop=true,Adornee=head},head)
			local nm=N("TextLabel",{Size=U2(1,0,0,18),BackgroundTransparency=1,Text=p.DisplayName,TextColor3=WHITE,TextStrokeTransparency=0.4,Font=FB,TextSize=14},bb)
			local inf=N("TextLabel",{Size=U2(1,0,0,14),Position=UO(0,18),BackgroundTransparency=1,Text="",TextColor3=WHITE,TextStrokeTransparency=0.4,Font=FR,TextSize=12},bb)
			local bar=N("Frame",{Size=U2(0.7,0,0,5),Position=U2(0.15,0,0,36),BackgroundColor3=Color3.new(0,0,0),BorderSizePixel=0},bb)
			local fill=N("Frame",{Size=US(1,1),BorderSizePixel=0},bar)
			local line
			if hasDraw then
				pcall(function()
					line=Drawing.new("Line")
					line.Thickness=1.5
					line.Visible=false
				end)
			end
			o={c=c,rt=rt,hm=hm,hl=hl,bb=bb,nm=nm,inf=inf,fill=fill,line=line}
			obj[p]=o
		end
		return o
	end
	function F.esp(on)
		if con then con:Disconnect() con=nil end
		if on then
			con=RS.RenderStepped:Connect(function()
				local my,c=gR(),workspace.CurrentCamera
				if not c then return end
				local op=S.opts
				for _,p in ipairs(Pl:GetPlayers()) do
					if p~=LP then
						local o=ensure(p)
						if o then
							local dist=my and (o.rt.Position-my.Position).Magnitude or 0
							local vis=dist<=op.maxDist
							local col=(op.team and p.Team) and p.TeamColor.Color or C3(255,70,70)
							local pct=o.hm.MaxHealth>0 and math.clamp(o.hm.Health/o.hm.MaxHealth,0,1) or 0
							o.hl.Enabled=vis and op.chams
							o.hl.FillColor=col
							o.hl.FillTransparency=op.fillT
							o.bb.Enabled=vis and op.info
							o.nm.TextColor3=col
							o.inf.Text=math.floor(dist).." studs | "..math.max(0,math.floor(o.hm.Health)).." HP"
							o.fill.Size=US(pct,1)
							o.fill.BackgroundColor3=Color3.fromHSV(pct*0.33,0.9,1)
							if o.line then
								local pos,onS=c:WorldToViewportPoint(o.rt.Position)
								if vis and op.tracers and onS then
									o.line.Visible=true
									o.line.Color=col
									o.line.From=Vector2.new(c.ViewportSize.X/2,c.ViewportSize.Y)
									o.line.To=Vector2.new(pos.X,pos.Y)
								else
									o.line.Visible=false
								end
							end
						end
					end
				end
			end)
		else
			for p in pairs(obj) do F.clearESP(p) end
		end
	end
	cleanups[#cleanups+1]=function() F.esp(false) end
end
do
	local function tr(p)
		local c=p.Character
		return c and (c:FindFirstChild("HumanoidRootPart") or c.PrimaryPart)
	end
	function F.tp(p)
		if not gR() then return false,"Your character isn't loaded" end
		if not p or p.Parent~=Pl then return false,"That player left" end
		if not tr(p) then return false,"Target not loaded (too far?)" end
		local h=gH()
		if h and h.SeatPart then h.Sit=false end
		mark()
		for _=1,4 do
			local t,r=tr(p),gR()
			if not t or not r then break end
			pivot(t.CFrame*CFrame.new(0,0,3))
			r.AssemblyLinearVelocity=ZERO
			RS.Heartbeat:Wait()
		end
		return true
	end
	function F.saveLoc(i)
		local r=gR()
		if not r then return nil end
		S.saved[i]=r.CFrame
		return S.saved[i]
	end
	function F.tpSaved(i)
		if not S.saved[i] then return false,"Slot "..i.." is empty, tap Save first" end
		local r=gR()
		if not r then return false,"Your character isn't loaded" end
		mark()
		pivot(S.saved[i])
		r.AssemblyLinearVelocity=ZERO
		return true
	end
	function F.tpSpawn()
		local r=gR()
		if not r then return false,"Your character isn't loaded" end
		local sp=LP.RespawnLocation or workspace:FindFirstChildWhichIsA("SpawnLocation",true)
		if not sp then return false,"No spawn point found" end
		mark()
		pivot(sp.CFrame+V3(0,5,0))
		r.AssemblyLinearVelocity=ZERO
		return true
	end
	function F.back()
		if not S.prev then return false,"No earlier position yet" end
		local r=gR()
		if not r then return false,"Your character isn't loaded" end
		local cur=r.CFrame
		pivot(S.prev)
		r.AssemblyLinearVelocity=ZERO
		S.prev=cur
		return true
	end
	function F.spectate(p)
		local c,h=workspace.CurrentCamera,nil
		if p then
			local ch=p.Character
			h=ch and ch:FindFirstChildOfClass("Humanoid")
			if not h then return false end
		else
			h=gH()
		end
		if c and h then c.CameraSubject=h end
		return true
	end
	function F.tick(list,t)
		if S.busy or S.godBusy then return 0 end
		local r=gR()
		if not r then return 0 end
		S.busy=true
		local origin,n=r.CFrame,0
		for _,p in ipairs(list) do
			local t0,ok=os.clock(),false
			repeat
				local tt,rr=tr(p),gR()
				if not tt or not rr then break end
				ok=true
				pivot(tt.CFrame)
				rr.AssemblyLinearVelocity=ZERO
				RS.Heartbeat:Wait()
			until os.clock()-t0>=t
			if ok then n=n+1 end
		end
		pivot(origin)
		local rr=gR()
		if rr then rr.AssemblyLinearVelocity=ZERO end
		S.busy=false
		return n
	end
	function F.godFling(p,prog)
		if S.godBusy or S.busy then return false,"Already running" end
		if S.flying then return false,"Turn off Fly first" end
		local r=gR()
		if not r then return false,"Your character isn't loaded" end
		if not p or p.Parent~=Pl then return false,"That player left" end
		local t=tr(p)
		if not t then return false,"Target not loaded (too far?)" end
		S.godBusy=true
		local wasNC=S.ncOn
		if wasNC then F.noclip(false) end
		local h=gH()
		if h then h.PlatformStand=true end
		local origin,start,t0,ang=r.CFrame,t.Position,os.clock(),0
		local flung,why,lastP=false,nil,0
		while true do
			RS.Heartbeat:Wait()
			local el=os.clock()-t0
			r,t=gR(),tr(p)
			if el>8 then why="Target didn't fling (try again)" break end
			if not r then why="Your character is gone" break end
			if not t or p.Parent~=Pl then why="Target left or died" break end
			local tv=t.AssemblyLinearVelocity
			if (t.Position-start).Magnitude>180 or tv.Magnitude>260 or t.Position.Y<workspace.FallenPartsDestroyHeight+30 then
				flung=true
				break
			end
			if r.Position.Y<workspace.FallenPartsDestroyHeight+60 then why="Stopped before you fell into the void" break end
			if prog and el-lastP>=0.5 then
				lastP=el
				prog(math.max(0,math.ceil(8-el)))
			end
			S.grace=os.clock()+0.7
			ang=ang+1.7
			r.CFrame=CFrame.new(t.Position+tv*0.09+V3(math.cos(ang)*1.4,math.sin(ang*0.6)*1.2,math.sin(ang)*1.4))*CFrame.Angles(ang,ang*0.7,0)
			r.AssemblyLinearVelocity=V3(1e5,1e5,1e5)
			r.AssemblyAngularVelocity=V3(1e5,1e5,1e5)
			RS.RenderStepped:Wait()
			r=gR()
			if r then
				r.AssemblyLinearVelocity=ZERO
				r.AssemblyAngularVelocity=ZERO
			end
		end
		for _=1,6 do
			r=gR()
			if not r then break end
			r.AssemblyLinearVelocity=ZERO
			r.AssemblyAngularVelocity=ZERO
			pivot(origin)
			RS.Heartbeat:Wait()
		end
		h=gH()
		if h then h.PlatformStand=false end
		if wasNC then F.noclip(true) end
		S.godBusy=false
		return flung,(not flung) and why or nil
	end
	cleanups[#cleanups+1]=function() F.spectate(nil) end
end
do
	local function owned(d)
		local m=d:FindFirstAncestorOfClass("Model")
		while m do
			if Pl:GetPlayerFromCharacter(m) then return true end
			m=m:FindFirstAncestorOfClass("Model")
		end
		return d:FindFirstAncestorWhichIsA("Player")~=nil
	end
	function F.scanTools()
		local found,n={},0
		for _,nm in ipairs({"ReplicatedStorage","ReplicatedFirst","StarterPack","StarterGui","StarterPlayer","Lighting","Workspace"}) do
			local ok,list=pcall(function() return game:GetService(nm):GetDescendants() end)
			if ok then
				for _,d in ipairs(list) do
					n=n+1
					if n%1500==0 then task.wait() end
					if d:IsA("Tool") and not owned(d) then found[#found+1]=d end
				end
			end
		end
		table.sort(found,function(a,b) return a.Name:lower()<b.Name:lower() end)
		return found
	end
	function F.giveTool(t)
		local bp=LP:FindFirstChildOfClass("Backpack")
		if not bp or not t or not t.Parent then return false end
		return (pcall(function() t:Clone().Parent=bp end))
	end
end
do
	local function aimTarget(c)
		local ctr=c.ViewportSize/2
		local best,bd=nil,S.aimRad
		local rp=RaycastParams.new()
		rp.FilterType=Enum.RaycastFilterType.Exclude
		rp.FilterDescendantsInstances={gC()}
		for _,p in ipairs(Pl:GetPlayers()) do
			local ch=p~=LP and p.Character
			local head=ch and ch:FindFirstChild(S.aimPart or "Head")
			local h=ch and ch:FindFirstChildOfClass("Humanoid")
			if head and h and h.Health>0 and not (S.aimTeam and p.Team and p.Team==LP.Team) then
				local pos,on=c:WorldToViewportPoint(head.Position)
				local d=(Vector2.new(pos.X,pos.Y)-ctr).Magnitude
				if on and d<bd then
					local ok=true
					if S.aimWall then
						local res=workspace:Raycast(c.CFrame.Position,head.Position-c.CFrame.Position,rp)
						ok=not res or res.Instance:IsDescendantOf(ch)
					end
					if ok then best,bd=head,d end
				end
			end
		end
		return best
	end
	pcall(function() RS:UnbindFromRenderStep("SamsHubCam") end)
	RS:BindToRenderStep("SamsHubCam",Enum.RenderPriority.Camera.Value+1,function()
		local c=workspace.CurrentCamera
		if not c then return end
		if S.fovWant then c.FieldOfView=S.fovWant end
		if S.aimOn then
			local t=aimTarget(c)
			if t then c.CFrame=c.CFrame:Lerp(CFrame.lookAt(c.CFrame.Position,t.Position),math.clamp(S.aimStr/100,0.02,1)) end
		end
	end)
	cleanups[#cleanups+1]=function() pcall(function() RS:UnbindFromRenderStep("SamsHubCam") end) end
end
do
	local SUM={Marin={2562,36610},Muichiro={2887,18461}}
	local chars="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
	local map={}
	for i=1,64 do map[chars:byte(i)]=i-1 end
	local function dec(s)
		s=s:gsub("~(%d+)~",function(n) return string.rep("fHx8",tonumber(n)) end)
		local out,acc,bits={},0,0
		for i=1,#s do
			local v=map[s:byte(i)]
			if v then
				acc=acc*64+v
				bits=bits+6
				if bits>=8 then
					bits=bits-8
					local p=2^bits
					out[#out+1]=string.char(math.floor(acc/p))
					acc=acc%p
				end
			end
		end
		return table.concat(out)
	end
	local cache={}
	function F.skinImage(name)
		if cache[name] then return cache[name] end
		local ok,res=pcall(function()
			local f="samshub_"..name:lower()..".jpg"
			local want=SUM[name]
			local have=isfile(f)
			if have and #readfile(f)~=want[1] then have=false end
			if not have then
				local d=dec(IMG[name])
				local sum=0
				for i=1,#d do sum=sum+d:byte(i) end
				if #d~=want[1] or sum%65521~=want[2] then error("picture data damaged") end
				writefile(f,d)
			end
			return (getcustomasset or getsynasset)(f)
		end)
		if ok and res then
			cache[name]=res
			return res
		end
		return ""
	end
end
local TOG,BTN,SLD,SEC,LB,NO,DDN,KEY,TOGK
do
	local gui=N("ScreenGui",{Name=GUI_NAME,ResetOnSpawn=false,ZIndexBehavior=Enum.ZIndexBehavior.Sibling,DisplayOrder=999,IgnoreGuiInset=true},parent)
	cleanups[#cleanups+1]=function() gui:Destroy() end
	UI.gui=gui
	function LB(par,text,size,pos,ck,font,ts,ax)
		local l=N("TextLabel",{Size=size,Position=pos or UO(0,0),BackgroundTransparency=1,Text=text,Font=font or FR,TextSize=ts or 13,TextXAlignment=ax or XA.Left,TextTruncate=Enum.TextTruncate.AtEnd},par)
		if ck=="white" then l.TextColor3=WHITE elseif typeof(ck)=="Color3" then l.TextColor3=ck else B(l,"TextColor3",ck) end
		return l
	end
	local function drag(h,t,click)
		local on,moved,ds,sp=false,false,nil,nil
		h.InputBegan:Connect(function(i)
			if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
				on,moved,ds,sp=true,false,i.Position,t.Position
				i.Changed:Connect(function()
					if i.UserInputState==Enum.UserInputState.End then
						on=false
						if not moved and click then click() end
					end
				end)
			end
		end)
		TK(UIS.InputChanged:Connect(function(i)
			if on and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then
				local d=i.Position-ds
				if d.Magnitude>6 then moved=true end
				if moved then t.Position=U2(sp.X.Scale,sp.X.Offset+d.X,sp.Y.Scale,sp.Y.Offset+d.Y) end
			end
		end))
	end
	UI.drag=drag
	local nh=N("Frame",{AnchorPoint=Vector2.new(1,1),Position=U2(1,-12,1,-12),Size=UO(290,320),BackgroundTransparency=1,ZIndex=50},gui)
	N("UIListLayout",{Padding=UDim.new(0,6),HorizontalAlignment=Enum.HorizontalAlignment.Right,VerticalAlignment=Enum.VerticalAlignment.Bottom,SortOrder=Enum.SortOrder.LayoutOrder},nh)
	local nn=0
	F.toast=function(msg,kind)
		if S.quiet and kind~="err" then return end
		nn=nn+1
		local col=kind=="err" and C3(255,90,90) or kind=="warn" and C3(255,190,70) or T.accent
		local card=N("CanvasGroup",{Size=UO(270,0),AutomaticSize=Enum.AutomaticSize.Y,GroupTransparency=1,BackgroundColor3=T.bg,LayoutOrder=nn},nh)
		CO(card,12)
		N("UIStroke",{Thickness=1,Transparency=0.4,Color=col},card)
		N("Frame",{Size=U2(0,4,1,0),BorderSizePixel=0,BackgroundColor3=col},card)
		local tx=N("TextLabel",{Position=UO(14,0),Size=U2(1,-24,0,0),AutomaticSize=Enum.AutomaticSize.Y,BackgroundTransparency=1,Text=tostring(msg),TextColor3=WHITE,Font=FM,TextSize=13,TextWrapped=true,TextXAlignment=XA.Left},card)
		N("UIPadding",{PaddingTop=UDim.new(0,9),PaddingBottom=UDim.new(0,10)},tx)
		local sc=N("UIScale",{Scale=0.92},card)
		tw(card,0.25,{GroupTransparency=0},ES.Quint)
		tw(sc,0.3,{Scale=1},ES.Back)
		task.delay(2.6,function()
			tw(card,0.25,{GroupTransparency=1})
			tw(sc,0.25,{Scale=0.92})
			task.wait(0.28)
			card:Destroy()
		end)
		local k={}
		for _,c in ipairs(nh:GetChildren()) do
			if c:IsA("CanvasGroup") then k[#k+1]=c end
		end
		if #k>4 then k[1]:Destroy() end
	end
