	local side=N("Frame",{Position=UO(10,4),Size=U2(0,SW,1,-14),BackgroundTransparency=1},body)
	local sbox=N("Frame",{Size=UO(SW,30),BackgroundTransparency=0.25},side)
	B(sbox,"BackgroundColor3","panel")
